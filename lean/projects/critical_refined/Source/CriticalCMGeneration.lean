import CriticalDoubleFieldMap
import CriticalEllipticGenerators

noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 1500000
namespace FourCorner.CriticalCMGeneration
open CriticalEllipticField CriticalDoubleCM
variable (k : Type*) [Field k]

/-- The actual native E field is generated by its CM image and the displayed
square root. The recovery is on the original x,y functions, not formal labels. -/
theorem eq_top_of_contains (i : k) (hi : i^2 = -1) (h2 : (2:k)≠0)
    (S : IntermediateField k (field k))
    (himage : ∀ z, CriticalDoubleFieldMap.map k i hi h2 z∈S)
    (hr : rootX (algebraMap k (field k) i) (x k) (y k)∈S) : S=⊤ := by
  let I:=algebraMap k (field k) i
  have hI : I^2 = -1 := by simpa only [map_pow,map_neg,map_one] using congrArg (algebraMap k (field k)) hi
  have h2F : (2:field k)≠0 := by simpa only [map_ofNat] using (_root_.map_ne_zero (algebraMap k (field k))).mpr h2
  have hxb:=himage (x k)
  have hyb:=himage (y k)
  rw [CriticalDoubleFieldMap.map_x] at hxb
  rw [CriticalDoubleFieldMap.map_y] at hyb
  have hxrec : recoverX I (xMap I (x k)) (yMap I (x k) (y k)) (rootX I (x k) (y k))∈S :=
    S.mul_mem (S.algebraMap_mem i) (S.add_mem hxb (S.div_mem hyb hr))
  have hyrec : recoverY I (xMap I (x k)) (yMap I (x k) (y k)) (rootX I (x k) (y k))∈S :=
    S.mul_mem (S.mul_mem (S.add_mem S.one_mem (S.algebraMap_mem i)) hxrec) hr
  rw [recover_x I _ _ hI h2F (CriticalDoubleFieldMap.x_nonzero k) (CriticalDoubleFieldMap.y_nonzero k)] at hxrec
  rw [recover_y I _ _ hI h2F (CriticalDoubleFieldMap.x_nonzero k) (CriticalDoubleFieldMap.y_nonzero k)] at hyrec
  exact CriticalEllipticGenerators.field_eq_top k S hxrec hyrec

end FourCorner.CriticalCMGeneration
#print axioms FourCorner.CriticalCMGeneration.eq_top_of_contains
