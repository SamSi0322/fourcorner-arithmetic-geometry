import QuadraticLinearNorm

noncomputable section
namespace FourCorner.TwoRootProductObstruction
open Multiquadratic.QuadraticSquareCriterion
variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- A coefficient obstruction for the actual field generated by two ordered roots. -/
theorem no_square (A B C d : F) (r s : E)
    (hr : r^2=algebraMap F E B) (hs : s^2=algebraMap F E C)
    (hB : ¬IsSquare B) (hC : ¬IsSquare C) (hBC : ¬IsSquare (B*C))
    (h2 : (2:F)≠0) (hd : d^2=A^2*B-C) (hnC : ¬IsSquare (-C))
    (w : IntermediateField.adjoin F {r,s}) :
    (w:E)^2 ≠ 2*(s+algebraMap F E A*r) := by
  let K := IntermediateField.adjoin F {r}
  let T := IntermediateField.adjoin K {s}
  let rk : K := ⟨r,IntermediateField.subset_adjoin F {r} (by simp)⟩
  have hT : T.restrictScalars F=IntermediateField.adjoin F {r,s} := by
    simpa only [Set.singleton_union] using
      (IntermediateField.adjoin_adjoin_left (F:=F) (S:={r}) {s})
  let wt : T := ⟨w.val, by change w.val ∈ T.restrictScalars F; rw [hT]; exact w.property⟩
  have hsK : s^2=algebraMap K E (algebraMap F K C) := by
    exact hs.trans (IsScalarTower.algebraMap_apply F K E C)
  have hrK : rk^2=algebraMap F K B := by apply Subtype.ext; exact hr
  have hCK : ¬IsSquare (algebraMap F K C) := by
    intro hc
    rcases square_criterion B C r hr hB h2 hc with h|h
    · exact hC h
    · exact hBC h
  have h2K : (2:K)≠0 := by
    simpa only [map_ofNat] using (map_ne_zero (algebraMap F K)).mpr h2
  obtain ⟨u,v,hw⟩ := coordinates (algebraMap F K C) s hsK wt
  intro hsq
  have heq : (algebraMap K E u + algebraMap K E v*s)^2 =
      2*(s+algebraMap K E (algebraMap F K A)*algebraMap K E rk) := by
    change (wt:E)^2 = _ at hsq
    rw [hw] at hsq
    exact hsq
  have hc : algebraMap K E (u^2+v^2*algebraMap F K C-2*algebraMap F K A*rk) +
      algebraMap K E (2*u*v-2)*s=0 := by
    simp only [map_sub,map_add,map_mul,map_pow,map_ofNat]
    linear_combination heq - (algebraMap K E v)^2*hsK
  obtain ⟨h0,h1⟩ := map_add_mul_eq_zero (algebraMap F K C) s hsK hCK _ _ hc
  have huv : u*v=1 := by
    apply mul_left_cancel₀ h2K
    linear_combination h1
  have hdK : (algebraMap F K d)^2=(algebraMap F K A)^2*algebraMap F K B-algebraMap F K C := by
    simpa only [map_sub,map_mul,map_pow] using congrArg (algebraMap F K) hd
  have hdisc : (u^2-algebraMap F K A*rk)^2=(algebraMap F K d)^2 := by
    linear_combination u^2*h0 - algebraMap F K C*(u*v+1)*huv +
      (algebraMap F K A)^2*hrK - hdK
  have hn (D:F) (hD:D^2=d^2)
      (hu:u^2-algebraMap F K A*rk=algebraMap F K D) : False := by
    have hsquare : IsSquare (algebraMap F K D+algebraMap F K A*rk) := by
      refine ⟨u,?_⟩
      linear_combination -hu
    have hnorm := QuadraticLinearNorm.square_norm B r hr hB A D hsquare
    apply hnC
    have e : D^2-A^2*B = -C := by linear_combination hD+hd
    rwa [e] at hnorm
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp hdisc with h|h
  · exact hn d rfl h
  · apply hn (-d) (by ring)
    simpa only [map_neg] using h

#print axioms no_square
end FourCorner.TwoRootProductObstruction
