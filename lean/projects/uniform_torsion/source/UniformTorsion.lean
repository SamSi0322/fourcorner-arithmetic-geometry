import UniformNoOdd
import UniformGroupCore
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

namespace FourCorner.UniformTorsion

/-- The visible generator with its actual rational coordinates. -/
def torsionGenerator (mu nu : ℤ) (hm : Odd mu) : (curve mu nu).toAffine.Point :=
  orderFourPoint mu nu (mu_ne_zero_of_odd hm) (B_ne_zero hm)

theorem torsionGenerator_double (mu nu : ℤ) (hm : Odd mu) :
    2 • torsionGenerator mu nu hm = zeroPoint mu nu (B_ne_zero hm) := by
  simpa only [torsionGenerator, two_nsmul] using
    orderFourPoint_add_self mu nu (mu_ne_zero_of_odd hm) (B_ne_zero hm)

theorem torsionGenerator_order (mu nu : ℤ) (hm : Odd mu) :
    addOrderOf (torsionGenerator mu nu hm) = 4 :=
  orderFourPoint_addOrderOf mu nu (mu_ne_zero_of_odd hm) (B_ne_zero hm)

theorem torsionGenerator_four (mu nu : ℤ) (hm : Odd mu) :
    4 • torsionGenerator mu nu hm = 0 :=
  orderFourPoint_four_nsmul mu nu (mu_ne_zero_of_odd hm) (B_ne_zero hm)

/-- Complete classification of finite-order rational points, for every pair
of odd integer parameters. The group is Mathlib's actual curve point group. -/
theorem rational_torsion_classification {mu nu : ℤ} (hm : Odd mu) (hn : Odd nu)
    {P : (curve mu nu).toAffine.Point} (hP : IsOfFinAddOrder P) :
    P = 0 ∨ P = zeroPoint mu nu (B_ne_zero hm) ∨
      P = torsionGenerator mu nu hm ∨ P = -torsionGenerator mu nu hm := by
  let T := torsionGenerator mu nu hm
  have hker : ∀ Q : (curve mu nu).toAffine.Point, 2 • Q = 0 → Q = 0 ∨ Q = 2 • T := by
    intro Q hQ
    simpa only [T, torsionGenerator_double] using two_torsion_cases hm hn Q hQ
  have hhalf : ∀ Q : (curve mu nu).toAffine.Point, 2 • Q ≠ T := by
    intro Q hQ
    exact curve_no_half_at_B (B_not_rat_square hm)
      (orderFour_nonsingular (mu_ne_zero_of_odd hm) (B_ne_zero hm)) ⟨Q,hQ⟩
  have hh := finite_torsion_classification_of_no_half T
    (torsionGenerator_four mu nu hm) (no_odd_torsion hm hn) hker hhalf hP
  simpa only [T, torsionGenerator_double] using hh

/-- The rational torsion subgroup is exactly the subgroup generated by the
explicit order-four point. -/
theorem rational_torsion_eq_zmultiples {mu nu : ℤ} (hm : Odd mu) (hn : Odd nu) :
    AddCommGroup.torsion (curve mu nu).toAffine.Point =
      AddSubgroup.zmultiples (torsionGenerator mu nu hm) := by
  ext P
  change IsOfFinAddOrder P ↔ P ∈ AddSubgroup.zmultiples (torsionGenerator mu nu hm)
  constructor
  · intro hP
    rw [AddSubgroup.mem_zmultiples_iff]
    rcases rational_torsion_classification hm hn hP with rfl | rfl | rfl | rfl
    · exact ⟨0, by simp⟩
    · exact ⟨2, by simpa only [ofNat_zsmul] using torsionGenerator_double mu nu hm⟩
    · exact ⟨1, by simp⟩
    · exact ⟨-1, by simp⟩
  · intro hP
    rw [AddSubgroup.mem_zmultiples_iff] at hP
    obtain ⟨k,rfl⟩ := hP
    apply isOfFinAddOrder_iff_nsmul_eq_zero.mpr
    refine ⟨4, by norm_num, ?_⟩
    rw [smul_comm (4 : ℕ) k, torsionGenerator_four, zsmul_zero]

theorem rational_torsion_card {mu nu : ℤ} (hm : Odd mu) (hn : Odd nu) :
    Nat.card (AddCommGroup.torsion (curve mu nu).toAffine.Point) = 4 := by
  rw [rational_torsion_eq_zmultiples hm hn, Nat.card_zmultiples, torsionGenerator_order]

theorem rational_torsion_cyclic {mu nu : ℤ} (hm : Odd mu) (hn : Odd nu) :
    IsAddCyclic (AddCommGroup.torsion (curve mu nu).toAffine.Point) := by
  rw [rational_torsion_eq_zmultiples hm hn]
  infer_instance

/-- Every actual rational curve point in the strict quotient interval has
infinite order. -/
theorem point_between_nontorsion {mu nu : ℤ} (hm : Odd mu) (hn : Odd nu)
    {x y : ℚ} (hxy : (curve mu nu).toAffine.Nonsingular x y)
    (hx : 0 < x) (hxB : x < (B mu nu : ℚ)) :
    ¬ IsOfFinAddOrder (WeierstrassCurve.Affine.Point.some x y hxy) := by
  intro hf
  rcases rational_torsion_classification hm hn hf with h0 | hS | hT | hT
  · exact WeierstrassCurve.Affine.Point.some_ne_zero hxy h0
  · have hh := (WeierstrassCurve.Affine.Point.some.inj hS).1
    linarith
  · have hh := (WeierstrassCurve.Affine.Point.some.inj hT).1
    linarith
  · unfold torsionGenerator orderFourPoint at hT
    rw [WeierstrassCurve.Affine.Point.neg_some] at hT
    have hh := (WeierstrassCurve.Affine.Point.some.inj hT).1
    linarith

#print axioms rational_torsion_classification
#print axioms rational_torsion_eq_zmultiples
#print axioms rational_torsion_card
#print axioms rational_torsion_cyclic
#print axioms point_between_nontorsion
end FourCorner.UniformTorsion
