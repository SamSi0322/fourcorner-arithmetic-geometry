import ThetaLiteralModels
import ThetaModelBase
noncomputable section
set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
namespace FourCorner.ThetaSourceSmooth
open Algebra AlgebraicGeometry MvPolynomial CategoryTheory
open ThetaLiteralModels
universe u
variable {k : Type u} [Field k] [CharZero k]
set_option maxHeartbeats 3000000
set_option backward.isDefEq.respectTransparency.types false
lemma drop_table (j a : Fin 5) : ThetaAmbientChart.drop 4 j a =
    ![![0,0,1,2,3],![0,0,1,2,3],![0,1,0,2,3],![0,1,2,0,3],![0,1,2,3,0]] j a := by
  fin_cases j <;> fin_cases a <;> decide
abbrev ae := ThetaQuotientChart.affineEquation (sourceEquation k)
abbrev ar := ThetaQuotientChart.affineRing (sourceEquation k)
def ax (j : Fin 5) (a : Fin 4) : ar (k:=k) j := Ideal.Quotient.mk _ (X a)
def columns : Fin 4 → Fin 3 → Fin 4
  | 0 => ![1,2,3]
  | 1 => ![0,2,3]
  | 2 => ![0,1,3]
  | 3 => ![0,1,2]
lemma columns_injective (a : Fin 4) : Function.Injective (columns a) := by fin_cases a <;> decide
def pres (j : Fin 5) (a : Fin 4) : PreSubmersivePresentation k (ar (k:=k) j) (Fin 4) (Fin 3) :=
  .naive (v:=ae j) (columns a) (columns_injective a)
@[simp] lemma pderiv_nat (a : Fin 4) (n : ℕ) : pderiv a (n : MvPolynomial (Fin 4) k)=0 := by
  have h := (MvPolynomial.pderiv_C (i:=a) (a:=(n:k)))
  simpa only [map_natCast] using h
lemma jacobi (j : Fin 5) (a : Fin 4) :
    (pres (k:=k) j a).jacobiMatrix=fun r c=>pderiv (columns a r) (ae j c) := by
  apply Matrix.ext
  intro r c
  exact PreSubmersivePresentation.jacobiMatrix_apply (pres (k:=k) j a) r c
lemma pres_map (j : Fin 5) (a : Fin 4) (p : MvPolynomial (Fin 4) k) :
    algebraMap (pres j a).Ring (ar j) p=Ideal.Quotient.mk _ p := rfl

def eqScalar {F : Type*} [CommRing F] (j : Fin 5) (a : Fin 3) (x : Fin 4 → F) : F :=
  ![![-50*(x 3)^2 - (x 2)^2 + 1, (x 0)^2 - 51*(x 3)^2 - 14*(x 3)*(x 2) - (x 2)^2, (x 1)^2 - 51*(x 3)^2 + 14*(x 3)*(x 2) - (x 2)^2],
    ![(x 0)^2 - 50*(x 3)^2 - (x 2)^2, -51*(x 3)^2 - 14*(x 3)*(x 2) - (x 2)^2 + 1, (x 1)^2 - 51*(x 3)^2 + 14*(x 3)*(x 2) - (x 2)^2],
    ![(x 0)^2 - 50*(x 3)^2 - (x 2)^2, (x 1)^2 - 51*(x 3)^2 - 14*(x 3)*(x 2) - (x 2)^2, -51*(x 3)^2 + 14*(x 3)*(x 2) - (x 2)^2 + 1],
    ![(x 0)^2 - 50*(x 3)^2 - 1, (x 1)^2 - 51*(x 3)^2 - 14*(x 3) - 1, (x 2)^2 - 51*(x 3)^2 + 14*(x 3) - 1],
    ![(x 0)^2 - (x 3)^2 - 50, (x 1)^2 - (x 3)^2 - 14*(x 3) - 51, (x 2)^2 - (x 3)^2 + 14*(x 3) - 51]] j a
def minorScalar {F : Type*} [CommRing F] (j : Fin 5) (a : Fin 4) (x : Fin 4 → F) : F :=
  ![![-2800*(x 1)*(x 3)^2 + 8*(x 1)*(x 3)*(x 2) + 56*(x 1)*(x 2)^2, -2800*(x 0)*(x 3)^2 - 8*(x 0)*(x 3)*(x 2) + 56*(x 0)*(x 2)^2, -400*(x 0)*(x 1)*(x 3), -8*(x 0)*(x 1)*(x 2)],
    ![-2800*(x 1)*(x 3)^2 + 8*(x 1)*(x 3)*(x 2) + 56*(x 1)*(x 2)^2, 5712*(x 0)*(x 3)^2 - 112*(x 0)*(x 2)^2, 408*(x 0)*(x 1)*(x 3) + 56*(x 0)*(x 1)*(x 2), 56*(x 0)*(x 1)*(x 3) + 8*(x 0)*(x 1)*(x 2)],
    ![-2800*(x 1)*(x 3)^2 - 8*(x 1)*(x 3)*(x 2) + 56*(x 1)*(x 2)^2, 5712*(x 0)*(x 3)^2 - 112*(x 0)*(x 2)^2, -408*(x 0)*(x 1)*(x 3) + 56*(x 0)*(x 1)*(x 2), 56*(x 0)*(x 1)*(x 3) - 8*(x 0)*(x 1)*(x 2)],
    ![-400*(x 1)*(x 2)*(x 3), 408*(x 0)*(x 2)*(x 3) + 56*(x 0)*(x 2), -408*(x 0)*(x 1)*(x 3) + 56*(x 0)*(x 1), 8*(x 0)*(x 1)*(x 2)],
    ![-8*(x 1)*(x 2)*(x 3), 8*(x 0)*(x 2)*(x 3) + 56*(x 0)*(x 2), -8*(x 0)*(x 1)*(x 3) + 56*(x 0)*(x 1), 8*(x 0)*(x 1)*(x 2)]] j a
lemma relations {F : Type u} [Field F] [Algebra k F] (j : Fin 5) (f : ar (k:=k) j →ₐ[k] F) :
    ∀ a, eqScalar j a (fun b=>f (ax j b))=0 := by
  intro a
  have h : Ideal.Quotient.mk (ThetaQuotientChart.affineIdeal (sourceEquation k) j) (ae j a)=0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨a,rfl⟩)
  have h' := congrArg f h
  have hc (c : k) : f (Ideal.Quotient.mk (ThetaQuotientChart.affineIdeal (sourceEquation k) j) (C c))=algebraMap k F c := f.commutes c
  fin_cases j <;> fin_cases a
  all_goals simp [ae,ThetaQuotientChart.affineEquation,ThetaAmbientChart.dehom,sourceEquation,drop_table,
      map_ofNat,hc,map_natCast] at h'
  all_goals simp [eqScalar,ax]
  all_goals linear_combination h'
lemma jacobian_formula {F : Type u} [Field F] [Algebra k F] (j : Fin 5) (a : Fin 4) (f : ar (k:=k) j →ₐ[k] F) :
    f (pres j a).jacobian=minorScalar j a (fun b=>f (ax j b)) := by
  rw [PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,pres_map,jacobi,Matrix.det_fin_three]
  have hc (c : k) : f (Ideal.Quotient.mk (ThetaQuotientChart.affineIdeal (sourceEquation k) j) (C c))=algebraMap k F c := f.commutes c
  have hn14 (a : Fin 4) : pderiv a (14 : MvPolynomial (Fin 4) k)=0 := by
    have h := (MvPolynomial.pderiv_C (i:=a) (a:=(14:k)))
    simpa only [map_ofNat] using h
  have hn50 (a : Fin 4) : pderiv a (50 : MvPolynomial (Fin 4) k)=0 := by
    have h := (MvPolynomial.pderiv_C (i:=a) (a:=(50:k)))
    simpa only [map_ofNat] using h
  have hn51 (a : Fin 4) : pderiv a (51 : MvPolynomial (Fin 4) k)=0 := by
    have h := (MvPolynomial.pderiv_C (i:=a) (a:=(51:k)))
    simpa only [map_ofNat] using h
  fin_cases j <;> fin_cases a
  all_goals simp [ae,ThetaQuotientChart.affineEquation,ThetaAmbientChart.dehom,sourceEquation,drop_table,
      columns,hn14,hn50,hn51,pderiv_nat,pderiv_pow,map_ofNat,hc,map_natCast,minorScalar,ax]
  all_goals ring

