import GeometricTensorFrobenius
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

noncomputable section
open scoped TensorProduct
namespace FourCorner.GeometricTensorFrobenius
variable (k L F : Type*) [Field k] [Fintype k] [Field L] [Field F]
  [Algebra k L] [Algebra k F] [IsDomain (L ⊗[k] F)]
set_option maxHeartbeats 1500000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

abbrev sourceAlgebra : Algebra F (FractionRing (L ⊗[k] F)) :=
  (sourceInclusion k L F).toRingHom.toAlgebra

/-- The geometric fraction field is actually generated by the new constants
and the image of the original field; this is not a supplied generation datum. -/
theorem source_generates : IntermediateField.adjoin L (Set.range (sourceInclusion k L F)) = ⊤ := by
  let T := L ⊗[k] F
  let G := FractionRing T
  let S := IntermediateField.adjoin L (Set.range (sourceInclusion k L F))
  have hT (a : T) : algebraMap T G a ∈ S := by
    induction a using TensorProduct.induction_on with
    | zero => simpa only [map_zero] using S.zero_mem
    | add a b ha hb =>
      rw [map_add]
      exact S.add_mem ha hb
    | tmul l x =>
      have he : algebraMap T G (l ⊗ₜ[k] x) =
          algebraMap L G l * sourceInclusion k L F x := by
        rw [IsScalarTower.algebraMap_apply L T G l]
        change algebraMap T G (l ⊗ₜ[k] x) =
          algebraMap T G (algebraMap L T l) * algebraMap T G ((1 : L) ⊗ₜ[k] x)
        rw [← map_mul,Algebra.TensorProduct.algebraMap_apply,Algebra.algebraMap_self_apply,
          Algebra.TensorProduct.tmul_mul_tmul,mul_one,one_mul]
      rw [he]
      exact S.mul_mem (S.algebraMap_mem l) (IntermediateField.subset_adjoin L _ ⟨x,rfl⟩)
  apply top_unique
  intro z _
  obtain ⟨a,b,hb,hz⟩ := IsFractionRing.div_surjective T z
  rw [← hz]
  exact S.div_mem (hT a) (hT b)

theorem source_algebra_generates :
    letI := sourceAlgebra k L F
    IntermediateField.adjoin L (Set.range (algebraMap F (FractionRing (L ⊗[k] F)))) = ⊤ := by
  letI := sourceAlgebra k L F
  change IntermediateField.adjoin L (Set.range (sourceInclusion k L F)) = ⊤
  exact source_generates k L F

theorem geometricFrobenius_algebraMap :
    letI := sourceAlgebra k L F
    ∀ x : F, geometricFrobenius k L F (algebraMap F (FractionRing (L ⊗[k] F)) x) =
      algebraMap F (FractionRing (L ⊗[k] F)) (x^(Nat.card k)) := by
  letI := sourceAlgebra k L F
  intro x
  change geometricFrobenius k L F (sourceInclusion k L F x) =
    sourceInclusion k L F (x^(Nat.card k))
  simpa only [Nat.card_eq_fintype_card] using geometricFrobenius_source k L F x

end FourCorner.GeometricTensorFrobenius
#print axioms FourCorner.GeometricTensorFrobenius.source_generates
#print axioms FourCorner.GeometricTensorFrobenius.geometricFrobenius_algebraMap
