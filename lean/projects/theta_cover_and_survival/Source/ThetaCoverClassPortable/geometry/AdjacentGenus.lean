import ThetaCoverClassPortable.geometry.AdjacentPlaceOrders
import ThetaCoverClassPortable.geometry.BiquadraticRamificationSum

noncomputable section
namespace FourCorner.AdjacentGenus
open AlgebraicCurve AdjacentPolynomials AdjacentPlaceOrders
variable {K : Type*} [Field K] [CharZero K]

/-- The actual extension generated by the two remaining literal distance roots. -/
abbrev field (c : K) :=
  Biquadratic.field (RatFunc K) (actualValue c 0) (actualValue c 1)

theorem degree_four {c : K} (h : Admissible c) :
    Module.finrank (RatFunc K) (field c) = 4 :=
  Biquadratic.finrank_field (RatFunc K) _ _ (by norm_num)
    (actualValue_independentSquareclasses h)

/-- Riemann--Hurwitz for the concrete two quartics and their common squared
conic denominator; all degree and branch data have been derived. -/
theorem genusFF_eq_five [IsAlgClosed K] {c : K} (h : Admissible c) :
    genusFF K (field c) = 5 := by
  classical
  exact BiquadraticRamificationSum.genusFF_eq_five_of_degree_four_and_eight_branch_places
    (finiteRootPlaces c) (finiteRootPlaces_card h) (degree_four h)
    (ramificationIndex_formula h)

theorem rational_degree_four (c : ℚ) (hc : 0 < c) (hc1 : c ≠ 1) :
    Module.finrank (RatFunc K) (field (algebraMap ℚ K c)) = 4 :=
  degree_four (rational_admissible c hc hc1)

theorem rational_genusFF_eq_five [IsAlgClosed K] (c : ℚ) (hc : 0 < c) (hc1 : c ≠ 1) :
    genusFF K (field (algebraMap ℚ K c)) = 5 :=
  genusFF_eq_five (rational_admissible c hc hc1)

theorem geometric_genusFF_eq_five (c : ℚ) (hc : 0 < c) (hc1 : c ≠ 1) :
    genusFF (AlgebraicClosure ℚ) (field (algebraMap ℚ (AlgebraicClosure ℚ) c)) = 5 :=
  rational_genusFF_eq_five c hc hc1

#print axioms degree_four
#print axioms genusFF_eq_five
#print axioms rational_degree_four
#print axioms rational_genusFF_eq_five
#print axioms geometric_genusFF_eq_five
end FourCorner.AdjacentGenus
