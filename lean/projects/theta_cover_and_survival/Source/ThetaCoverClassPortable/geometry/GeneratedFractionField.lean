import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Localization.FractionRing

/-!
An embedded domain is a coordinate ring for its generated field.
If `F` is the fraction field of `R`, and the field `E / F` is generated by
elements coming from `B`, then every element of `E` is a fraction of elements
of `B`. The conclusion is the actual `IsFractionRing B E` structure.
-/

noncomputable section

namespace FourCorner.GeneratedFractionField

variable (R B F E : Type*) [CommRing R] [CommRing B] [IsDomain B]
  [Field F] [Field E] [Algebra R F] [IsFractionRing R F]
  [Algebra R B] [Algebra R E] [Algebra B E] [Algebra F E]
  [IsScalarTower R B E] [IsScalarTower R F E]

include R

/-- Field generation makes the canonical map from the fraction field of `B` surjective. -/
theorem lift_surjective_of_adjoin_eq_top
    (hinj : Function.Injective (algebraMap B E))
    (S : Set E) (hS : S ⊆ Set.range (algebraMap B E))
    (hgen : IntermediateField.adjoin F S = ⊤) :
    Function.Surjective (IsFractionRing.lift (K := FractionRing B) hinj) := by
  let φ : FractionRing B →+* E := IsFractionRing.lift hinj
  have hB : ∀ b : B, algebraMap B E b ∈ φ.fieldRange := by
    intro b
    exact ⟨algebraMap B (FractionRing B) b, IsFractionRing.lift_algebraMap hinj b⟩
  have hR : ∀ r : R, algebraMap R E r ∈ φ.fieldRange := by
    intro r
    rw [IsScalarTower.algebraMap_apply R B E]
    exact hB (algebraMap R B r)
  have hF : Set.range (algebraMap F E) ⊆ φ.fieldRange := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨a, b, _, hab⟩ := IsFractionRing.div_surjective R x
    rw [← hab, map_div₀, ← IsScalarTower.algebraMap_apply R F E,
      ← IsScalarTower.algebraMap_apply R F E]
    exact φ.fieldRange.div_mem (hR a) (hR b)
  have hS' : S ⊆ φ.fieldRange := by
    intro x hx
    obtain ⟨b, rfl⟩ := hS hx
    exact hB b
  have hfull : φ.fieldRange = ⊤ := by
    apply top_unique
    simpa only [hgen, IntermediateField.top_toSubfield] using
      (IntermediateField.adjoin_le_subfield F S hF hS')
  exact RingHom.fieldRange_eq_top_iff.mp hfull

/-- Every field element has an actual numerator and a nonzero denominator in `B`. -/
theorem exists_fraction_of_adjoin_eq_top
    (hinj : Function.Injective (algebraMap B E))
    (S : Set E) (hS : S ⊆ Set.range (algebraMap B E))
    (hgen : IntermediateField.adjoin F S = ⊤) (z : E) :
    ∃ a b : B, b ≠ 0 ∧ z = algebraMap B E a / algebraMap B E b := by
  obtain ⟨w, hw⟩ := lift_surjective_of_adjoin_eq_top R B F E hinj S hS hgen z
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective B w
  refine ⟨a, b, mem_nonZeroDivisors_iff_ne_zero.mp hb, ?_⟩
  rw [← hw, ← hab, map_div₀, IsFractionRing.lift_algebraMap,
    IsFractionRing.lift_algebraMap]

/-- The generated field is the fraction field of the embedded coordinate domain. -/
theorem isFractionRing_of_adjoin_eq_top
    (hinj : Function.Injective (algebraMap B E))
    (S : Set E) (hS : S ⊆ Set.range (algebraMap B E))
    (hgen : IntermediateField.adjoin F S = ⊤) : IsFractionRing B E := by
  have : FaithfulSMul B E := (faithfulSMul_iff_algebraMap_injective B E).mpr hinj
  apply IsFractionRing.of_field B E
  intro z
  obtain ⟨a, b, _, h⟩ := exists_fraction_of_adjoin_eq_top R B F E hinj S hS hgen z
  exact ⟨a, b, h⟩

/-- Convenience form for a finite list of coordinate generators. -/
theorem isFractionRing_of_finset_adjoin_eq_top
    (hinj : Function.Injective (algebraMap B E))
    (S : Finset E) (hS : (S : Set E) ⊆ Set.range (algebraMap B E))
    (hgen : IntermediateField.adjoin F (S : Set E) = ⊤) : IsFractionRing B E :=
  isFractionRing_of_adjoin_eq_top R B F E hinj S hS hgen

end FourCorner.GeneratedFractionField

#check @FourCorner.GeneratedFractionField.lift_surjective_of_adjoin_eq_top
#check @FourCorner.GeneratedFractionField.exists_fraction_of_adjoin_eq_top
#check @FourCorner.GeneratedFractionField.isFractionRing_of_adjoin_eq_top
#check @FourCorner.GeneratedFractionField.isFractionRing_of_finset_adjoin_eq_top
#print axioms FourCorner.GeneratedFractionField.lift_surjective_of_adjoin_eq_top
#print axioms FourCorner.GeneratedFractionField.exists_fraction_of_adjoin_eq_top
#print axioms FourCorner.GeneratedFractionField.isFractionRing_of_adjoin_eq_top
#print axioms FourCorner.GeneratedFractionField.isFractionRing_of_finset_adjoin_eq_top
