import ThetaCoverClassPortable.geometry.SquarefreeRatFunc
import ThetaCoverClassPortable.geometry.MultiquadraticField
import ThetaCoverClassPortable.geometry.OppositePolynomials

noncomputable section
open scoped BigOperators
open Polynomial

namespace FourCorner.OppositeFunctionField
open OppositePolynomials
variable {K : Type*} [Field K] [CharZero K]

/-- The three literal quadratic polynomials, viewed in the actual rational-function field. -/
def radicandValue (mu nu : K) (i : Fin 3) : RatFunc K :=
  algebraMap K[X] (RatFunc K) (radicand mu nu i)

/-- The geometric generic field of the three-radical model, constructed rather
than postulated as cover data. -/
abbrev field (mu nu : K) : IntermediateField (RatFunc K) (AlgebraicClosure (RatFunc K)) :=
  Multiquadratic.field (RatFunc K)
    (radicandValue mu nu 0) (radicandValue mu nu 1) (radicandValue mu nu 2)

/-- Every nonempty product has a simple polynomial factor and hence is
nonsquare in the rational-function field. -/
theorem nonempty_product_nonsquare {mu nu : K} (hmu : mu ≠ 0) (hnu : nu ≠ 0)
    (hA : A mu nu ≠ 0) (hB : B mu nu ≠ 0) (hS : S mu nu ≠ 0)
    (s : Finset (Fin 3)) (hne : s.Nonempty) :
    ¬ IsSquare (∏ i ∈ s, radicandValue mu nu i) := by
  have h := CoverFields.polynomial_prod_not_isSquare_ratFunc s (radicand mu nu) hne
    (fun i _ j _ hij => (radicand_isCoprime hA hB hS hij).isRelPrime)
    (fun i _ => radicand_squarefree hmu hnu hA i)
    (fun i _ => radicand_not_isUnit mu nu i)
  simpa only [radicandValue, map_prod] using h

/-- Exact degree eight of the field generated by the concrete radicands. -/
theorem finrank_field_eq_eight {mu nu : K} (hmu : mu ≠ 0) (hnu : nu ≠ 0)
    (hA : A mu nu ≠ 0) (hB : B mu nu ≠ 0) (hS : S mu nu ≠ 0) :
    Module.finrank (RatFunc K) (field mu nu) = 8 := by
  exact Multiquadratic.finrank_field_eq_eight_of_products (RatFunc K)
    (radicandValue mu nu) (by norm_num)
    (nonempty_product_nonsquare hmu hnu hA hB hS)

/-- The hypotheses for the actual degree-eight field follow from precisely the
rational range in the opposite-pair proposition. -/
theorem rational_finrank_field_eq_eight (mu nu : ℚ) (hnu : nu ≠ 0)
    (hpos : 0 < mu / nu) (hlt : mu / nu < 2) :
    Module.finrank (RatFunc K) (field (algebraMap ℚ K mu) (algebraMap ℚ K nu)) = 8 := by
  have hmu : mu ≠ 0 := by intro hz; simp [hz] at hpos
  apply finrank_field_eq_eight
  · exact (map_ne_zero (algebraMap ℚ K)).2 hmu
  · exact (map_ne_zero (algebraMap ℚ K)).2 hnu
  · simpa only [A_map] using (map_ne_zero (algebraMap ℚ K)).2 (rational_A_ne_zero mu nu hnu)
  · simpa only [B_map] using (map_ne_zero (algebraMap ℚ K)).2
      (rational_B_ne_zero mu nu hnu hpos hlt)
  · simpa only [S_map] using (map_ne_zero (algebraMap ℚ K)).2 (rational_S_ne_zero mu nu hnu)

#print axioms nonempty_product_nonsquare
#print axioms finrank_field_eq_eight
#print axioms rational_finrank_field_eq_eight
end FourCorner.OppositeFunctionField
