#check @FourCorner.RatFuncFiniteExtension.isCurveOver_of_charZero
#check @FourCorner.RatFuncFiniteExtension.isCurveOver_of_isAlgClosed
#check @FourCorner.RatFuncFiniteExtension.genus_base_eq_zero
