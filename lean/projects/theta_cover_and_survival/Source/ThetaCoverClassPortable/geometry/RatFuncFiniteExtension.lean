import Mathlib.FieldTheory.RatFunc.IntermediateField
import ThetaCoverClassPortable.Theorems.Thm_AlgebraicCurve_two_mul_genusFF_sub_two_eq_of_isSeparable_of_tame
import ThetaCoverClassPortable.Theorems.Thm_AlgebraicCurve_genusFF_ratFunc_eq_zero_of_isAlgClosed

/-!
Concrete curve structures on finite extensions of a rational function field.
The distinguished coordinate is the image of `RatFunc.X`. Its transcendence and
the finite dimension over the field it generates are proved from the given
field extension. Over a perfect constant field, a separating coordinate then
supplies the actual `AlgebraicCurve.IsCurveOver` structure.
-/

noncomputable section

namespace FourCorner.RatFuncFiniteExtension

open IntermediateField

variable (K : Type*) [Field K]

/-- The rational function field is finite over the field generated by its coordinate. -/
theorem base_finiteDimensional : FiniteDimensional K⟮(RatFunc.X : RatFunc K)⟯ (RatFunc K) := by
  rw [RatFunc.adjoin_X]
  exact Module.Finite.of_surjective
    (Algebra.linearMap (⊤ : IntermediateField K (RatFunc K)) (RatFunc K))
    (fun x => ⟨⟨x, trivial⟩, rfl⟩)

/-- The base field's explicit one-variable witness is `RatFunc.X`. -/
theorem base_oneVariable :
    ∃ x : RatFunc K, Transcendental K x ∧ FiniteDimensional K⟮x⟯ (RatFunc K) :=
  ⟨RatFunc.X, RatFunc.transcendental_X, base_finiteDimensional K⟩

variable (E : Type*) [Field E] [Algebra K E] [Algebra (RatFunc K) E]
  [IsScalarTower K (RatFunc K) E]

/-- The image of the rational coordinate remains transcendental in an extension. -/
theorem transcendental_X : Transcendental K (algebraMap (RatFunc K) E RatFunc.X) :=
  (transcendental_algebraMap_iff (algebraMap (RatFunc K) E).injective).mpr
    RatFunc.transcendental_X

variable [FiniteDimensional (RatFunc K) E]

/-- The actual extension is finite over the subfield generated by the coordinate image. -/
theorem finiteDimensional_adjoin_X :
    FiniteDimensional K⟮algebraMap (RatFunc K) E RatFunc.X⟯ E :=
  P2MW.S_AlgebraicCurve_two_mul_genusFF_sub_two_eq_of_isSeparable_of_tame.AlgebraicCurve.RiemannHurwitzGenusFF.finiteDimensional_adjoin_algebraMap
    RatFunc.X (base_finiteDimensional K)

/-- The one-variable hypothesis needed by the accepted Riemann-Hurwitz theorem. -/
theorem oneVariable : ∃ x : E, Transcendental K x ∧ FiniteDimensional K⟮x⟯ E :=
  ⟨algebraMap (RatFunc K) E RatFunc.X, transcendental_X K E,
    finiteDimensional_adjoin_X K E⟩

/-- Finite extension of `K(X)` also supplies essential finite type over `K`. -/
theorem essFiniteType : Algebra.EssFiniteType K E :=
  AlgebraicCurve.essFiniteType_of_transcendental_of_finiteDimensional
    (transcendental_X K E) (finiteDimensional_adjoin_X K E)

/-- Over perfect constants, the curve structure is derived using a separating coordinate. -/
theorem isCurveOver_of_perfectField [PerfectField K] : AlgebraicCurve.IsCurveOver K E := by
  obtain ⟨x, hx, hfin, hsep⟩ :=
    AlgebraicCurve.exists_separating_transcendental_of_perfectField
      (transcendental_X K E) (finiteDimensional_adjoin_X K E)
  exact AlgebraicCurve.isCurveOver_of_transcendental_of_isSeparable K E x hx hfin hsep

/-- Characteristic zero gives a curve structure without an assumed curve package. -/
theorem isCurveOver_of_charZero [CharZero K] : AlgebraicCurve.IsCurveOver K E :=
  isCurveOver_of_perfectField K E

/-- Algebraic closure of the constants suffices, including positive characteristic. -/
theorem isCurveOver_of_isAlgClosed [IsAlgClosed K] : AlgebraicCurve.IsCurveOver K E := by
  have : PerfectField K := IsAlgClosed.perfectField K
  exact isCurveOver_of_perfectField K E

/-- The accepted genus invariant of the rational base is zero. -/
theorem genus_base_eq_zero [IsAlgClosed K] : AlgebraicCurve.genusFF K (RatFunc K) = 0 :=
  AlgebraicCurve.genusFF_ratFunc_eq_zero_of_isAlgClosed K

end FourCorner.RatFuncFiniteExtension

