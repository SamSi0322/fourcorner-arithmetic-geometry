import ThetaCoverClassPortable.geometry.OppositeRamification
import ThetaCoverClassPortable.geometry.RatFuncFiniteExtension
import ThetaCoverClassPortable.geometry.RamificationSum
import ThetaCoverClassPortable.geometry.OppositeLiteralCoordinates

/-!
The function-field form of the opposite-pair genus proposition. The field is
the actual extension generated by the three ordered roots of the original
radicands f_i/A. Its dimension, finite branch places, every ramification index,
and the unramified infinity place have all been derived before applying the
accepted function-field Riemann--Hurwitz theorem.
-/

noncomputable section
open AlgebraicCurve
namespace FourCorner.OppositeGenus
open OppositePolynomials OppositePlaceOrders

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K]

/-- The genuine geometric function field of the opposite-pair model has genus
five under the explicit nondegeneracy conditions of its three quadratics. -/
theorem genusFF_eq_five {mu nu : K} (hmu : mu ≠ 0) (hnu : nu ≠ 0)
    (hA : A mu nu ≠ 0) (hB : B mu nu ≠ 0) (hS : S mu nu ≠ 0) :
    genusFF K (OppositeNormalizedField.field mu nu) = 5 := by
  classical
  let : IsCurveOver K (RatFunc K) :=
    RatFuncFiniteExtension.isCurveOver_of_charZero K (RatFunc K)
  let : IsCurveOver K (OppositeNormalizedField.field mu nu) :=
    RatFuncFiniteExtension.isCurveOver_of_charZero K (OppositeNormalizedField.field mu nu)
  apply RamificationSum.genusFF_eq_five_of_degree_eight_and_six_branch_places
    (RatFuncFiniteExtension.base_oneVariable K) (RatFuncFiniteExtension.genus_base_eq_zero K)
    (finiteRootPlaces mu nu) (finiteRootPlaces_card hmu hnu hA hB hS)
    (OppositeNormalizedField.finrank_field_eq_eight hmu hnu hA hB hS)
  exact OppositeRamification.ramificationIndex_formula hmu hnu hA hB hS

/-- Rational parameter range 0 < mu/nu < 2 supplies all nondegeneracy facts;
no extension degree, ramification pattern, or genus value is an assumption. -/
theorem rational_genusFF_eq_five (mu nu : ℚ) (hnu : nu ≠ 0)
    (hpos : 0 < mu / nu) (hlt : mu / nu < 2) :
    genusFF K (OppositeNormalizedField.field (algebraMap ℚ K mu) (algebraMap ℚ K nu)) = 5 := by
  have hmu : mu ≠ 0 := by intro hz; simp [hz] at hpos
  apply genusFF_eq_five
  · exact (map_ne_zero (algebraMap ℚ K)).2 hmu
  · exact (map_ne_zero (algebraMap ℚ K)).2 hnu
  · simpa only [A_map] using (map_ne_zero (algebraMap ℚ K)).2 (rational_A_ne_zero mu nu hnu)
  · simpa only [B_map] using (map_ne_zero (algebraMap ℚ K)).2
      (rational_B_ne_zero mu nu hnu hpos hlt)
  · simpa only [S_map] using (map_ne_zero (algebraMap ℚ K)).2 (rational_S_ne_zero mu nu hnu)

/-- The geometric constant field may be taken to be the actual algebraic
closure of Q, giving the genus used for the projective normalization. -/
theorem geometric_genusFF_eq_five (mu nu : ℚ) (hnu : nu ≠ 0)
    (hpos : 0 < mu / nu) (hlt : mu / nu < 2) :
    genusFF (AlgebraicClosure ℚ)
      (OppositeNormalizedField.field (algebraMap ℚ (AlgebraicClosure ℚ) mu)
        (algebraMap ℚ (AlgebraicClosure ℚ) nu)) = 5 :=
  rational_genusFF_eq_five mu nu hnu hpos hlt

#check @genusFF_eq_five
#check @rational_genusFF_eq_five
#check @geometric_genusFF_eq_five
#print axioms genusFF_eq_five
#print axioms rational_genusFF_eq_five
#print axioms geometric_genusFF_eq_five
end FourCorner.OppositeGenus
