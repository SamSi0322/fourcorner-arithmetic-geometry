import ThetaCoverClassPortable.geometry.BiquadraticField
import ThetaCoverClassPortable.geometry.SquarefreeRatFunc

/-!
# Biquadratic polynomial fields with literal square denominators

The radicands are exactly `f / D²` and `g / D²` in the rational-function field.
Squarefree, coprime, nonunit numerators imply their squareclass independence.
The resulting actual field has degree four in characteristic zero.
-/

noncomputable section

namespace FourCorner.BiquadraticPolynomialField

open Polynomial

private theorem nonsquare_div_sq {F : Type*} [Field F] {x d : F}
    (hd : d ≠ 0) (hx : ¬ IsSquare x) : ¬ IsSquare (x / d ^ 2) := by
  intro h
  apply hx
  simpa only [div_mul_cancel₀ _ (pow_ne_zero 2 hd)] using h.mul (IsSquare.sq d)

private theorem nonsquare_div_sq_product {F : Type*} [Field F] {x y d : F}
    (hd : d ≠ 0) (hxy : ¬ IsSquare (x * y)) :
    ¬ IsSquare ((x / d ^ 2) * (y / d ^ 2)) := by
  rw [div_mul_div_comm, ← pow_two]
  exact nonsquare_div_sq (pow_ne_zero 2 hd) hxy

variable {K : Type*} [Field K]

/-- The literal polynomial quotient, with the square denominator retained. -/
def value (f D : K[X]) : RatFunc K :=
  algebraMap K[X] (RatFunc K) f / (algebraMap K[X] (RatFunc K) D) ^ 2

/-- The actual field generated by square roots of the two literal quotients. -/
abbrev field (f g D : K[X]) : IntermediateField (RatFunc K) (AlgebraicClosure (RatFunc K)) :=
  Biquadratic.field (RatFunc K) (value f D) (value g D)

theorem polynomialMap_ne_zero (f : K[X]) (hf : f ≠ 0) :
    algebraMap K[X] (RatFunc K) f ≠ 0 := by
  intro h
  apply hf
  apply IsFractionRing.injective K[X] (RatFunc K)
  simpa only [map_zero] using h

theorem value_ne_zero (f D : K[X]) (hf : f ≠ 0) (hD : D ≠ 0) : value f D ≠ 0 :=
  div_ne_zero (polynomialMap_ne_zero f hf) (pow_ne_zero 2 (polynomialMap_ne_zero D hD))

/-- Clearing the literal square denominator recovers the original numerator. -/
theorem value_mul_denominator_sq (f D : K[X]) (hD : D ≠ 0) :
    value f D * (algebraMap K[X] (RatFunc K) D) ^ 2 = algebraMap K[X] (RatFunc K) f :=
  div_mul_cancel₀ _ (pow_ne_zero 2 (polynomialMap_ne_zero D hD))

/-- A nonunit squarefree numerator stays nonsquare after division by the square denominator. -/
theorem value_not_isSquare (f D : K[X]) (hD : D ≠ 0)
    (hf : Squarefree f) (huf : ¬ IsUnit f) : ¬ IsSquare (value f D) :=
  nonsquare_div_sq (polynomialMap_ne_zero D hD)
    (CoverFields.squarefree_not_isSquare_fraction (F := RatFunc K) f hf huf)

/-- The product of the two literal radicands is also nonsquare. -/
theorem value_mul_not_isSquare (f g D : K[X]) (hD : D ≠ 0)
    (hf : Squarefree f) (hg : Squarefree g) (huf : ¬ IsUnit f)
    (hcop : IsCoprime f g) : ¬ IsSquare (value f D * value g D) := by
  apply nonsquare_div_sq_product (polynomialMap_ne_zero D hD)
  have hs : Squarefree (f * g) := squarefree_mul_iff.mpr ⟨hcop.isRelPrime, hf, hg⟩
  have hu : ¬ IsUnit (f * g) := by
    intro h
    exact huf (isUnit_of_dvd_unit (dvd_mul_right f g) h)
  simpa only [map_mul] using
    CoverFields.squarefree_not_isSquare_fraction (F := RatFunc K) (f * g) hs hu

/-- Actual squareclass independence from the polynomial hypotheses. -/
theorem independentSquareclasses (f g D : K[X]) (hD : D ≠ 0)
    (hf : Squarefree f) (hg : Squarefree g) (huf : ¬ IsUnit f) (hug : ¬ IsUnit g)
    (hcop : IsCoprime f g) :
    Biquadratic.IndependentSquareclasses (RatFunc K) (value f D) (value g D) where
  first := value_not_isSquare f D hD hf huf
  second := value_not_isSquare g D hD hg hug
  product := value_mul_not_isSquare f g D hD hf hg huf hcop

/-- Unconditional bound on the actual degree of the polynomial-quotient field. -/
theorem finrank_field_le_four (f g D : K[X]) :
    Module.finrank (RatFunc K) (field f g D) ≤ 4 :=
  Biquadratic.finrank_field_le_four (RatFunc K) _ _

/-- Exact degree four derived from squarefree coprime numerators and a nonzero denominator. -/
theorem finrank_field [CharZero K] (f g D : K[X]) (hD : D ≠ 0)
    (hf : Squarefree f) (hg : Squarefree g) (huf : ¬ IsUnit f) (hug : ¬ IsUnit g)
    (hcop : IsCoprime f g) : Module.finrank (RatFunc K) (field f g D) = 4 :=
  Biquadratic.finrank_field (RatFunc K) _ _ (by norm_num)
    (independentSquareclasses f g D hD hf hg huf hug hcop)

/-- The ordered root of the first literal radicand. -/
abbrev root₁ (f g D : K[X]) : field f g D :=
  Biquadratic.root₁ (RatFunc K) (value f D) (value g D)

/-- The ordered root of the second literal radicand. -/
abbrev root₂ (f g D : K[X]) : field f g D :=
  Biquadratic.root₂ (RatFunc K) (value f D) (value g D)

@[simp] theorem root₁_sq (f g D : K[X]) :
    root₁ f g D ^ 2 = algebraMap (RatFunc K) (field f g D) (value f D) :=
  Biquadratic.root₁_sq (RatFunc K) _ _

@[simp] theorem root₂_sq (f g D : K[X]) :
    root₂ f g D ^ 2 = algebraMap (RatFunc K) (field f g D) (value g D) :=
  Biquadratic.root₂_sq (RatFunc K) _ _

/-- The first root equation with its numerator and square denominator written literally. -/
theorem root₁_sq_literal (f g D : K[X]) :
    root₁ f g D ^ 2 =
      algebraMap (RatFunc K) (field f g D) (algebraMap K[X] (RatFunc K) f) /
        (algebraMap (RatFunc K) (field f g D) (algebraMap K[X] (RatFunc K) D)) ^ 2 := by
  rw [root₁_sq, value, map_div₀, map_pow]

/-- The second root equation with its numerator and square denominator written literally. -/
theorem root₂_sq_literal (f g D : K[X]) :
    root₂ f g D ^ 2 =
      algebraMap (RatFunc K) (field f g D) (algebraMap K[X] (RatFunc K) g) /
        (algebraMap (RatFunc K) (field f g D) (algebraMap K[X] (RatFunc K) D)) ^ 2 := by
  rw [root₂_sq, value, map_div₀, map_pow]

/-- The ordered roots generate the actual field. -/
theorem roots_generate (f g D : K[X]) :
    IntermediateField.adjoin (RatFunc K) {root₁ f g D, root₂ f g D} = ⊤ :=
  Biquadratic.roots_generate (RatFunc K) _ _

/-- The same ordered roots generate the actual algebra. -/
theorem roots_generate_algebra (f g D : K[X]) :
    Algebra.adjoin (RatFunc K) {root₁ f g D, root₂ f g D} = ⊤ :=
  Biquadratic.roots_generate_algebra (RatFunc K) _ _

end FourCorner.BiquadraticPolynomialField

#print axioms FourCorner.BiquadraticPolynomialField.independentSquareclasses
#print axioms FourCorner.BiquadraticPolynomialField.finrank_field
#print axioms FourCorner.BiquadraticPolynomialField.root₁_sq_literal
#print axioms FourCorner.BiquadraticPolynomialField.root₂_sq_literal
#print axioms FourCorner.BiquadraticPolynomialField.roots_generate
#print axioms FourCorner.BiquadraticPolynomialField.roots_generate_algebra
