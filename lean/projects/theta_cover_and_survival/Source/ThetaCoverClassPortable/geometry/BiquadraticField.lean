import ThetaCoverClassPortable.geometry.MultiquadraticTower

/-!
# An actual biquadratic field

The field is the second stage of the square-root tower inside an algebraic
closure. Its ordered roots generate it both as a field and as an algebra.
The unconditional degree bound and the degree-four theorem refer to its actual
`Module.finrank`.
-/

noncomputable section

namespace FourCorner.Biquadratic

open Multiquadratic

variable (F : Type*) [Field F]

/-- The intermediate field generated by the two chosen square roots. -/
abbrev field (a b : F) : IntermediateField F (AlgebraicClosure F) :=
  Tower.second F a b

/-- Independence of the two squareclasses, expressed by actual nonsquares. -/
structure IndependentSquareclasses (a b : F) : Prop where
  first : ¬ IsSquare a
  second : ¬ IsSquare b
  product : ¬ IsSquare (a * b)

/-- The first root, mapped from the first stage into the second stage. -/
def root₁ (a b : F) : field F a b :=
  algebraMap (Tower.first F a) (field F a b) (Tower.stepRoot₁ F a)

/-- The second root, adjoined at the second stage. -/
def root₂ (a b : F) : field F a b := Tower.stepRoot₂ F a b

@[simp] theorem root₁_sq (a b : F) :
    root₁ F a b ^ 2 = algebraMap F (field F a b) a := by
  apply Subtype.ext
  exact radical_sq F a

@[simp] theorem root₂_sq (a b : F) :
    root₂ F a b ^ 2 = algebraMap F (field F a b) b := by
  apply Subtype.ext
  exact radical_sq F b

/-- The two ordered roots generate the whole intermediate field. -/
theorem roots_generate (a b : F) :
    IntermediateField.adjoin F {root₁ F a b, root₂ F a b} = ⊤ := by
  apply IntermediateField.lift_injective (field F a b)
  simp only [IntermediateField.lift_adjoin, IntermediateField.lift_top,
    Set.image_insert_eq, Set.image_singleton, root₁, root₂]
  rfl

/-- Because the roots are algebraic, they also generate the whole algebra. -/
theorem roots_generate_algebra (a b : F) :
    Algebra.adjoin F {root₁ F a b, root₂ F a b} = ⊤ := by
  apply (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic _).mp
    (roots_generate F a b)
  intro x _
  exact (IsIntegral.of_finite F x).isAlgebraic

/-- The actual extension degree is at most four, without a characteristic hypothesis. -/
theorem finrank_field_le_four (a b : F) : Module.finrank F (field F a b) ≤ 4 := by
  have heq : field F a b = IntermediateField.adjoin F {radical F a} ⊔
      IntermediateField.adjoin F {radical F b} := by
    rw [← IntermediateField.adjoin_union, Set.singleton_union]
    rfl
  rw [heq]
  calc
    _ ≤ Module.finrank F (IntermediateField.adjoin F {radical F a}) *
        Module.finrank F (IntermediateField.adjoin F {radical F b}) :=
      IntermediateField.finrank_sup_le _ _
    _ ≤ 2 * 2 := Nat.mul_le_mul (finrank_radical_le_two F a) (finrank_radical_le_two F b)
    _ = 4 := by norm_num

/-- Independent squareclasses give actual degree four in characteristic different from two. -/
theorem finrank_field (a b : F) (h2 : (2 : F) ≠ 0)
    (hind : IndependentSquareclasses F a b) : Module.finrank F (field F a b) = 4 :=
  Tower.finrank_second F a b h2 hind.first hind.second hind.product

/-- The second square-root adjunction has relative degree two. -/
theorem finrank_step₂ (a b : F) (h2 : (2 : F) ≠ 0)
    (hind : IndependentSquareclasses F a b) :
    Module.finrank (Tower.first F a) (field F a b) = 2 := by
  have h := Module.finrank_mul_finrank F (Tower.first F a) (field F a b)
  rw [Tower.finrank_first F a hind.first, finrank_field F a b h2 hind] at h
  omega

end FourCorner.Biquadratic

#print axioms FourCorner.Biquadratic.root₁_sq
#print axioms FourCorner.Biquadratic.root₂_sq
#print axioms FourCorner.Biquadratic.roots_generate
#print axioms FourCorner.Biquadratic.roots_generate_algebra
#print axioms FourCorner.Biquadratic.finrank_field_le_four
#print axioms FourCorner.Biquadratic.finrank_field
#print axioms FourCorner.Biquadratic.finrank_step₂
