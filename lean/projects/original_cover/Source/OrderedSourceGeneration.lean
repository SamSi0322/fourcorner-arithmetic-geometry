import OrderedSourceInverse
noncomputable section
namespace FourCorner.OriginalCoverCompletion.OrderedSource
open IntermediateField

/-- A rational-function map lands in a subfield as soon as its constants and variable do. -/
theorem ratFunc_map_mem {K E : Type*} [Field K] [Field E]
    (f : RatFunc K →+* E) (S : Subfield E)
    (hC : ∀ z : K, f (RatFunc.C z)∈S) (hX : f RatFunc.X∈S) (z : RatFunc K) : f z∈S := by
  have hpoly (p : Polynomial K) : f (algebraMap (Polynomial K) (RatFunc K) p)∈S := by
    induction p using Polynomial.induction_on' with
    | add p q hp hq => simpa only [map_add] using S.add_mem hp hq
    | monomial m a =>
      rw [←Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_mul, map_pow, map_pow]
      simpa only [RatFunc.algebraMap_C,RatFunc.algebraMap_X] using S.mul_mem (hC a) (S.pow_mem hX m)
  induction z using RatFunc.induction_on with
  | f p q hq =>
    rw [map_div₀]
    exact S.div_mem (hpoly p) (hpoly q)

/-- The field generated by the literal original image and the one manuscript root. -/
def returnedRootField (n : ℚ) : IntermediateField ℚ (sourceField n) :=
  IntermediateField.adjoin ℚ (Set.range (originalImage n) ∪ {sourceQ n})

theorem image_mem (n : ℚ) (i : Fin 6) : originalImage n i∈returnedRootField n :=
  subset_adjoin _ _ (Or.inl (Set.mem_range_self i))
theorem q_mem (n : ℚ) : sourceQ n∈returnedRootField n :=
  subset_adjoin _ _ (Or.inr (by simp))
theorem n_mem (n : ℚ) : nCoord n∈returnedRootField n := by
  rw [nCoord_eq]; exact (returnedRootField n).algebraMap_mem n

theorem pure_coords_mem (n : ℚ) (hn : n≠0) :
    pureU n∈returnedRootField n ∧ pureV n∈returnedRootField n ∧
    pureW n∈returnedRootField n ∧ pureT n∈returnedRootField n ∧
    pureP n∈returnedRootField n ∧ pureBeta n∈returnedRootField n := by
  let K := returnedRootField n
  have hr := image_mem n
  have hrec := originalImage_recover n hn
  have hpar := originalImage_parameters n hn
  dsimp only at hrec hpar
  have hdiff : originalImage n 2-originalImage n 5∈K := K.sub_mem (hr 2) (hr 5)
  have hsum : originalImage n 2+originalImage n 5∈K := K.add_mem (hr 2) (hr 5)
  have he : originalImage n 4-originalImage n 3∈K := K.sub_mem (hr 4) (hr 3)
  have htwo : (2:sourceField n)∈K := K.natCast_mem 2
  refine ⟨?_,?_,?_,?_,?_,?_⟩
  · rw [←hrec.1]; exact K.div_mem hsum hdiff
  · rw [←hrec.2.1]; exact K.div_mem (K.mul_mem htwo he) hdiff
  · rw [←hrec.2.2.1]; exact K.div_mem (K.mul_mem htwo (K.add_mem (hr 3) (hr 4))) hdiff
  · rw [←hrec.2.2.2]; exact K.div_mem htwo hdiff
  · rw [←hpar.1]; exact K.div_mem (K.sub_mem htwo (K.toSubalgebra.pow_mem he 2)) (K.toSubalgebra.pow_mem hdiff 2)
  · rw [←hpar.2]; exact K.div_mem (K.toSubalgebra.pow_mem hsum 2) (K.sub_mem htwo (K.toSubalgebra.pow_mem he 2))

theorem source_coords_mem (n : ℚ) (hn : n≠0) :
    aCoord n∈returnedRootField n ∧ cCoord n∈returnedRootField n ∧
    ∀i, orderedRoot n i∈returnedRootField n := by
  let K := returnedRootField n
  obtain ⟨hU,hV,hW,hT,hP,hB⟩ := pure_coords_mem n hn
  have hN := n_mem n
  have ha : aCoord n∈K := by rw [←source_recover_a n hn]; exact K.div_mem (K.neg_mem hN) hP
  have hc : cCoord n∈K := by
    rw [←source_recover_c n hn]
    exact K.div_mem (K.mul_mem hN (K.add_mem hB K.one_mem)) (K.sub_mem hB K.one_mem)
  have htwo : (2:sourceField n)∈K := K.natCast_mem 2
  have hu : uCoord n∈K := by
    rw [←source_recover_u n]
    exact K.div_mem (K.mul_mem (q_mem n) (K.add_mem ha hc)) htwo
  have hv : vCoord n∈K := by
    rw [←source_recover_v n hn]
    exact K.div_mem (K.mul_mem (K.mul_mem htwo (K.sub_mem ha hN)) hu) (K.mul_mem ha hW)
  refine ⟨ha,hc,?_⟩
  intro i; fin_cases i
  · change bCoord n∈K
    rw [←source_recover_b n hn]
    exact K.div_mem (K.mul_mem (K.mul_mem (K.neg_mem ha) hv) hV) htwo
  · change ellCoord n∈K
    rw [←source_recover_ell n hn]
    exact K.mul_mem (K.mul_mem hU hu) (K.sub_mem hc hN)
  · exact hu
  · exact hv
  · change hCoord n∈K
    rw [←source_recover_h n hn]
    exact K.div_mem hT (K.mul_mem htwo hU)

theorem base_mem (n : ℚ) (hn : n≠0) (z : BaseField) :
    algebraMap BaseField (sourceField n) z∈returnedRootField n := by
  let K := returnedRootField n
  obtain ⟨ha,hc,hroots⟩ := source_coords_mem n hn
  have hcoeff (c : CoefficientField) : coefficientMap n c∈K := by
    apply ratFunc_map_mem (coefficientMap n) K.toSubfield _ hc c
    intro r
    change algebraMap BaseField (sourceField n) (RatFunc.C (RatFunc.C r))∈K
    have hh : algebraMap BaseField (sourceField n) (RatFunc.C (RatFunc.C r))=
        algebraMap ℚ (sourceField n) r := by
      exact RingHom.congr_fun (Subsingleton.elim
        ((algebraMap BaseField (sourceField n)).comp
          ((RatFunc.C : CoefficientField →+* BaseField).comp (RatFunc.C : ℚ →+* CoefficientField)))
        (algebraMap ℚ (sourceField n))) r
    rw [hh]; exact K.algebraMap_mem r
  exact ratFunc_map_mem (algebraMap BaseField (sourceField n)) K.toSubfield hcoeff ha z

/-- Genuine generation of the independently presented ordered source by its actual
six original coordinates and q. Injectivity of OriginalRing is a separate statement. -/
theorem returnedRootField_eq_top (n : ℚ) (hn : n≠0) : returnedRootField n=⊤ := by
  apply top_unique
  rintro ⟨z,hz⟩ ht
  clear ht
  change (⟨z,hz⟩:sourceField n)∈returnedRootField n
  induction hz using IntermediateField.adjoin_induction with
  | mem x hx =>
    have hh := (source_coords_mem n hn).2.2
    rcases hx with hx|hx|hx|hx|hx
    all_goals subst x
    · exact hh 0
    · exact hh 1
    · exact hh 2
    · exact hh 3
    · exact hh 4
  | algebraMap x => exact base_mem n hn x
  | add x y hx hy ihx ihy => exact (returnedRootField n).add_mem ihx ihy
  | inv x hx ih => exact (returnedRootField n).inv_mem ih
  | mul x y hx hy ihx ihy => exact (returnedRootField n).mul_mem ihx ihy

#print axioms returnedRootField_eq_top
#print axioms source_coords_mem
end FourCorner.OriginalCoverCompletion.OrderedSource
