import QuadraticOrderEvaluation
import QuadraticDiscriminant

noncomputable section
namespace FourCorner.QuadraticClosureEvaluation
open Polynomial
variable {A F E : Type*} [CommRing A] [IsDomain A] [Field F] [Field E]
  [CharZero F] [Algebra ℚ A] [Algebra A F] [IsFractionRing A F]
  [Algebra F E] [Algebra A E] [IsScalarTower A F E] [IsIntegrallyClosed A]

theorem root_integral (B : PowerBasis F E) (a : A)
    (hz : B.gen^2 = algebraMap A E a) : IsIntegral A B.gen := by
  refine ⟨X^2-C a,monic_X_pow_sub_C a (by decide),?_⟩
  simpa only [eval₂_sub,eval₂_pow,eval₂_X,eval₂_C,sub_eq_zero] using hz

/-- In a quadratic unit extension of a rational valuation ring, the entire
integral closure is the actual order generated by the specified fifth root. -/
theorem closure_eq_order (B : PowerBasis F E) (hdim : B.dim = 2)
    (a : A) (ha : IsUnit a) (hns : ¬ IsSquare (algebraMap A F a))
    (hz : B.gen^2 = algebraMap A E a) :
    integralClosure A E = Algebra.adjoin A ({B.gen} : Set E) := by
  letI : FiniteDimensional F E := B.finite
  have h4 : IsUnit (4 : A) := by
    simpa only [map_ofNat] using
      (isUnit_iff_ne_zero.mpr (by norm_num : (4 : ℚ) ≠ 0)).map (algebraMap ℚ A)
  have hzF : B.gen^2 = algebraMap F E (algebraMap A F a) :=
    hz.trans (IsScalarTower.algebraMap_apply A F E a)
  apply UnitDiscriminantClosure.integralClosure_eq_adjoin B (root_integral B a hz) (4*a) (h4.mul ha)
  simp only [map_mul,map_ofNat,QuadraticDiscriminant.discr_eq B hdim (algebraMap A F a) hns hzF]

def evaluate (B : PowerBasis F E) (hdim : B.dim = 2)
    (a : A) (ha : IsUnit a) (hns : ¬ IsSquare (algebraMap A F a))
    (hz : B.gen^2 = algebraMap A E a) (f : A →+* ℚ) (u : ℚ) (hu : u^2 = f a) :
    integralClosure A E →+* ℚ :=
  (QuadraticOrderEvaluation.evalAdjoin a B.gen hz hns f u hu).comp
    (Subalgebra.equivOfEq _ _ (closure_eq_order B hdim a ha hns hz)).toRingHom

theorem evaluate_algebraMap (B : PowerBasis F E) (hdim : B.dim = 2)
    (a : A) (ha : IsUnit a) (hns : ¬ IsSquare (algebraMap A F a))
    (hz : B.gen^2 = algebraMap A E a) (f : A →+* ℚ) (u : ℚ) (hu : u^2 = f a) (r : A) :
    evaluate B hdim a ha hns hz f u hu (algebraMap A (integralClosure A E) r) = f r := by
  change QuadraticOrderEvaluation.evalAdjoin a B.gen hz hns f u hu
    ((Subalgebra.equivOfEq _ _ (closure_eq_order B hdim a ha hns hz)) (algebraMap A _ r)) = _
  rw [AlgEquiv.commutes]
  exact QuadraticOrderEvaluation.evalAdjoin_algebraMap a B.gen hz hns f u hu r

theorem evaluate_root (B : PowerBasis F E) (hdim : B.dim = 2)
    (a : A) (ha : IsUnit a) (hns : ¬ IsSquare (algebraMap A F a))
    (hz : B.gen^2 = algebraMap A E a) (f : A →+* ℚ) (u : ℚ) (hu : u^2 = f a) :
    evaluate B hdim a ha hns hz f u hu ⟨B.gen,root_integral B a hz⟩ = u := by
  change QuadraticOrderEvaluation.evalAdjoin a B.gen hz hns f u hu ⟨B.gen,_⟩ = u
  exact QuadraticOrderEvaluation.evalAdjoin_root a B.gen hz hns f u hu

end FourCorner.QuadraticClosureEvaluation
#print axioms FourCorner.QuadraticClosureEvaluation.closure_eq_order
#print axioms FourCorner.QuadraticClosureEvaluation.evaluate_algebraMap
#print axioms FourCorner.QuadraticClosureEvaluation.evaluate_root
