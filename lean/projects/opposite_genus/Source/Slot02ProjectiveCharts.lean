import Slot02ProjectiveQuotient
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.MvPolynomial.Homogeneous

noncomputable section
open AlgebraicGeometry MvPolynomial HomogeneousIdealQuotientGrading
attribute [local instance] MvPolynomial.gradedAlgebra
set_option maxHeartbeats 2000000
set_option autoImplicit false
namespace FourCorner.ProjectiveQuotientCharts
universe u
variable (R : Type u) [CommRing R] (n : ℕ)


theorem irrelevant_le_span_X :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule (Fin (n + 1)) R)).toIdeal ≤
      Ideal.span (Set.range (X : Fin (n + 1) → MvPolynomial _ R)) := by
  rw [HomogeneousIdeal.toIdeal_irrelevant_le]
  intro i hi f hf
  have hf' : f.IsHomogeneous i := (mem_homogeneousSubmodule i f).mp hf
  show f ∈ MvPolynomial.idealOfVars (Fin (n + 1)) R
  rw [← pow_one (MvPolynomial.idealOfVars _ R), MvPolynomial.mem_pow_idealOfVars_iff]
  intro x hx
  rw [MvPolynomial.mem_support_iff] at hx
  have hd : Finsupp.degree x = i := by
    rw [Finsupp.degree_eq_weight_one]
    exact hf' hx
  omega

variable (J : HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R))


abbrev coordinate (i : Fin (n + 1)) : MvPolynomial (Fin (n + 1)) R ⧸ (J.toIdeal : Ideal (MvPolynomial (Fin (n + 1)) R)) :=
  quotientGradedMap (homogeneousSubmodule (Fin (n + 1)) R) J (X i)

theorem coordinate_mem_one (i : Fin (n + 1)) : coordinate R n J i ∈ (quotGrading (homogeneousSubmodule (Fin (n + 1)) R) J.toIdeal) 1 :=
  (quotientGradedMap (homogeneousSubmodule (Fin (n + 1)) R) J).map_mem ((mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X R i))

/-- The quotient's irrelevant ideal is generated by the actual images of the variables. -/
theorem irrelevant_le_span_coordinates :
    (HomogeneousIdeal.irrelevant (quotGrading (homogeneousSubmodule (Fin (n + 1)) R) J.toIdeal)).toIdeal ≤ Ideal.span (Set.range (coordinate R n J)) := by
  have h := ProjectiveClosedImmersion.irrelevant_le_map_of_surjective
    (quotientGradedMap (homogeneousSubmodule (Fin (n + 1)) R) J) (quotientGradedMap_surjective (homogeneousSubmodule (Fin (n + 1)) R) J)
  change (HomogeneousIdeal.irrelevant (quotGrading (homogeneousSubmodule (Fin (n + 1)) R) J.toIdeal)).toIdeal ≤
    Ideal.map (quotientGradedMap (homogeneousSubmodule (Fin (n + 1)) R) J) (HomogeneousIdeal.irrelevant (homogeneousSubmodule (Fin (n + 1)) R)).toIdeal at h
  have hh := h.trans (Ideal.map_mono (irrelevant_le_span_X R n))
  simpa only [Ideal.map_span, ← Set.range_comp, coordinate, Function.comp_def] using hh

/-- A finite actual affine cover of any homogeneous polynomial quotient Proj. -/
def affineOpenCover : (Proj (quotGrading (homogeneousSubmodule (Fin (n + 1)) R) J.toIdeal)).AffineOpenCover :=
  Proj.affineOpenCoverOfIrrelevantLESpan (quotGrading (homogeneousSubmodule (Fin (n + 1)) R) J.toIdeal) (coordinate R n J)
    (coordinate_mem_one R n J) (fun _ => one_pos) (irrelevant_le_span_coordinates R n J)

theorem affineOpenCover_f (i : Fin (n + 1)) :
    (affineOpenCover R n J).openCover.f i =
      Proj.awayι (quotGrading (homogeneousSubmodule (Fin (n + 1)) R) J.toIdeal) (coordinate R n J i) (coordinate_mem_one R n J i) one_pos := rfl

end FourCorner.ProjectiveQuotientCharts
#print axioms FourCorner.ProjectiveQuotientCharts.irrelevant_le_span_coordinates
#print axioms FourCorner.ProjectiveQuotientCharts.affineOpenCover
#print axioms FourCorner.ProjectiveQuotientCharts.affineOpenCover_f
