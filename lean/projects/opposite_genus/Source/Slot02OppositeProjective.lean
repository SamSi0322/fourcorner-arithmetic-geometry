import Slot02ProjectiveCharts
import geometry.OppositeHomogeneousQuadrics

/-! The genuine three-quadric projective scheme and its closed immersion.
No identification with the normalized proper model is asserted here. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousIdealQuotientGrading
attribute [local instance] MvPolynomial.gradedAlgebra
namespace FourCorner.OppositeProjective
universe u
variable {K : Type u} [Field K] [CharZero K]

abbrev grading (K : Type u) [Field K] := homogeneousSubmodule (Fin 5) K

/-- Quotient of the actual five-variable polynomial ring by the three literal quadrics. -/
abbrev coordinateRing (mu nu : K) :=
  OppositeHomogeneousQuadrics.Ambient K ⧸ OppositeHomogeneousQuadrics.ideal mu nu

abbrev quotientGrading (mu nu : K) :=
  quotGrading (grading K) (OppositeHomogeneousQuadrics.ideal mu nu)

instance (mu nu : K) : GradedRing (quotientGrading mu nu) :=
  quotGradingGradedRingOfHomogeneous (grading K)
    (OppositeHomogeneousQuadrics.homogeneousIdeal mu nu)

/-- The actual closed projective subscheme, rather than a predicate on points. -/
def curve (mu nu : K) : Scheme := Proj (quotientGrading mu nu)

def embedding (mu nu : K) : curve mu nu ⟶ Proj (grading K) :=
  ProjectiveQuotient.quotientMap (grading K)
    (OppositeHomogeneousQuadrics.homogeneousIdeal mu nu)

theorem embedding_isClosedImmersion (mu nu : K) : IsClosedImmersion (embedding mu nu) :=
  ProjectiveQuotient.quotientMap_isClosedImmersion (grading K)
    (OppositeHomogeneousQuadrics.homogeneousIdeal mu nu)

/-- The quotient map kills exactly the ideal generated by the actual equations. -/
theorem equation_vanishes (mu nu : K) (i : Fin 3) :
    Ideal.Quotient.mk (OppositeHomogeneousQuadrics.ideal mu nu)
      (OppositeHomogeneousQuadrics.quadric mu nu i) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)

/-- The five genuine degree-zero-localization charts cover the projective subscheme. -/
def affineOpenCover (mu nu : K) : (curve mu nu).AffineOpenCover :=
  ProjectiveQuotientCharts.affineOpenCover K 4
    (OppositeHomogeneousQuadrics.homogeneousIdeal mu nu)

/-- Constants in the degree-zero piece of the ambient grading. -/
def constants : K →+* grading K 0 where
  toFun a := ⟨C a, (mem_homogeneousSubmodule 0 _).mpr (isHomogeneous_C _ a)⟩
  map_zero' := Subtype.ext (map_zero C)
  map_one' := Subtype.ext (map_one C)
  map_add' a b := Subtype.ext (map_add C a b)
  map_mul' a b := Subtype.ext (map_mul C a b)

/-- The ambient projective space structural morphism to the actual coefficient field. -/
def spaceToBase : Proj (grading K) ⟶ Spec (.of K) :=
  Proj.toSpecZero (grading K) ≫ Spec.map (CommRingCat.ofHom constants)

/-- The literal projective subscheme's structural morphism. -/
def toBase (mu nu : K) : curve mu nu ⟶ Spec (.of K) :=
  embedding mu nu ≫ (spaceToBase (K := K))

theorem embedding_over (mu nu : K) :
    embedding mu nu ≫ (spaceToBase (K := K)) = toBase mu nu := rfl

abbrev affineIdeal (mu nu : K) :=
  Ideal.span (Set.range (OppositeHomogeneousQuadrics.affineEquation mu nu))
abbrev affineRing (mu nu : K) :=
  OppositeHomogeneousQuadrics.AffineAmbient K ⧸ affineIdeal mu nu

/-- Reinsert the four affine variables into the five-variable polynomial ring. -/
def affineLift : OppositeHomogeneousQuadrics.AffineAmbient K →+*
    OppositeHomogeneousQuadrics.Ambient K := (rename (R := K) (Fin.castSucc : Fin 4 → Fin 5)).toRingHom

theorem dehomT_affineLift :
    OppositeHomogeneousQuadrics.dehomT.comp (affineLift (K := K)) = RingHom.id _ := by
  apply MvPolynomial.ringHom_ext
  · intro a
    simp [affineLift, OppositeHomogeneousQuadrics.dehomT]
  · intro i
    fin_cases i <;> simp [affineLift, OppositeHomogeneousQuadrics.dehomT]

theorem dehomT_surjective :
    Function.Surjective (OppositeHomogeneousQuadrics.dehomT (K := K)) := by
  intro p
  exact ⟨affineLift p, RingHom.congr_fun dehomT_affineLift p⟩

/-- The actual dehomogenization map descends through the actual equation ideals. -/
def dehomQuotient (mu nu : K) : coordinateRing mu nu →+* affineRing mu nu :=
  Ideal.quotientMap (affineIdeal mu nu) OppositeHomogeneousQuadrics.dehomT
    ((Ideal.map_le_iff_le_comap).mp (le_of_eq
      (OppositeHomogeneousQuadrics.dehomT_ideal mu nu)))

theorem dehomQuotient_surjective (mu nu : K) :
    Function.Surjective (dehomQuotient mu nu) :=
  Ideal.quotientMap_surjective dehomT_surjective

end FourCorner.OppositeProjective
#print axioms FourCorner.OppositeProjective.curve
#print axioms FourCorner.OppositeProjective.embedding
#print axioms FourCorner.OppositeProjective.embedding_isClosedImmersion
#print axioms FourCorner.OppositeProjective.equation_vanishes

#print axioms FourCorner.OppositeProjective.toBase
#print axioms FourCorner.OppositeProjective.embedding_over
#print axioms FourCorner.OppositeProjective.dehomT_affineLift
#print axioms FourCorner.OppositeProjective.dehomQuotient_surjective

#print axioms FourCorner.OppositeProjective.affineOpenCover
