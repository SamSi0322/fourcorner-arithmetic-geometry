import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.KummerPolynomial
import Mathlib.Tactic

/-!
# An actual field generated by three square roots

The construction takes place inside `AlgebraicClosure F`. Its degree bound is a
statement about `Module.finrank`, not a supplied numerical invariant. Neither the
construction nor the upper bound needs a characteristic assumption.
-/

noncomputable section

namespace FourCorner.Multiquadratic

open Polynomial IntermediateField

namespace QuadraticSquareCriterion
variable {F L : Type*} [Field F] [Field L] [Algebra F L]

/-- A square-root adjunction is spanned by one and the chosen root. -/
lemma coordinates (a : F) (r : L) (hr : r ^ 2 = algebraMap F L a)
    (x : IntermediateField.adjoin F {r}) :
    ∃ u v : F, (x : L) = algebraMap F L u + algebraMap F L v * r := by
  have hp : Polynomial.aeval r (X ^ 2 - C a : F[X]) = 0 := by simp [hr]
  have hi : IsIntegral F r := ⟨X ^ 2 - C a, monic_X_pow_sub_C a (by norm_num), hp⟩
  have hd : (minpoly F r).natDegree ≤ 2 := by
    simpa using Polynomial.natDegree_le_natDegree
      (minpoly.min F r (monic_X_pow_sub_C a (by norm_num)) hp)
  obtain ⟨f, hf, hxf⟩ := (IntermediateField.adjoin.powerBasis hi).exists_eq_aeval x
  change f.natDegree < (minpoly F r).natDegree at hf
  have hdeg : f.natDegree ≤ 1 := by omega
  refine ⟨f.coeff 0, f.coeff 1, ?_⟩
  rw [eq_X_add_C_of_natDegree_le_one hdeg] at hxf
  have hh := congrArg (fun z : IntermediateField.adjoin F {r} => (z : L)) hxf
  simpa [add_comm] using hh

/-- These two spanning vectors are independent when the radicand is a nonsquare. -/
lemma map_add_mul_eq_zero (a : F) (r : L) (hr : r ^ 2 = algebraMap F L a)
    (ha : ¬ IsSquare a) (u v : F)
    (h : algebraMap F L u + algebraMap F L v * r = 0) : u = 0 ∧ v = 0 := by
  have hv : v = 0 := by
    by_contra hv
    have hv' : algebraMap F L v ≠ 0 := (map_ne_zero (algebraMap F L)).mpr hv
    have he : r = algebraMap F L (-u / v) := by
      rw [map_div₀, map_neg]
      apply (eq_div_iff hv').2
      linear_combination h
    apply ha
    refine ⟨-u / v, ?_⟩
    apply (algebraMap F L).injective
    rw [map_mul, ← sq, ← he, hr]
  refine ⟨?_, hv⟩
  simpa [hv] using h

/-- The squareclass kernel of a quadratic extension consists of the trivial class
and the class of its radicand. -/
lemma square_criterion (a b : F) (r : L) (hr : r ^ 2 = algebraMap F L a)
    (ha : ¬ IsSquare a) (h2 : (2 : F) ≠ 0)
    (hb : IsSquare (algebraMap F (IntermediateField.adjoin F {r}) b)) :
    IsSquare b ∨ IsSquare (a * b) := by
  obtain ⟨x, hx⟩ := hb
  obtain ⟨u, v, hcoords⟩ := coordinates a r hr x
  have he : (algebraMap F L u + algebraMap F L v * r) ^ 2 = algebraMap F L b := by
    have hh := congrArg (fun z : IntermediateField.adjoin F {r} => (z : L)) hx
    simpa [hcoords, sq] using hh.symm
  have hcoeff : algebraMap F L (u ^ 2 + v ^ 2 * a - b) +
      algebraMap F L (2 * u * v) * r = 0 := by
    simp only [map_sub, map_add, map_mul, map_pow, map_ofNat]
    linear_combination he - (algebraMap F L v) ^ 2 * hr
  obtain ⟨hc, hd⟩ := map_add_mul_eq_zero a r hr ha _ _ hcoeff
  have huv : u = 0 ∨ v = 0 := by
    rcases mul_eq_zero.mp hd with h | h
    · exact Or.inl ((mul_eq_zero.mp h).resolve_left h2)
    · exact Or.inr h
  rcases huv with hu | hv
  · right
    refine ⟨a * v, ?_⟩
    simp only [hu, zero_pow (by norm_num : 2 ≠ 0), zero_add] at hc
    linear_combination -a * hc
  · left
    refine ⟨u, ?_⟩
    simpa [hv, sq] using (sub_eq_zero.mp hc).symm

/-- The squareclass kernel of a biquadratic extension lies in the four generated classes. -/
lemma biquadratic_square_criterion (a b c : F) (r s : L)
    (hr : r ^ 2 = algebraMap F L a) (hs : s ^ 2 = algebraMap F L b)
    (ha : ¬ IsSquare a) (hb : ¬ IsSquare b) (hab : ¬ IsSquare (a * b))
    (h2 : (2 : F) ≠ 0)
    (hc : IsSquare (algebraMap F (IntermediateField.adjoin F {r, s}) c)) :
    IsSquare c ∨ IsSquare (a * c) ∨ IsSquare (b * c) ∨ IsSquare (a * (b * c)) := by
  let K := IntermediateField.adjoin F {r}
  let T := IntermediateField.adjoin K {s}
  have hT : T.restrictScalars F = IntermediateField.adjoin F {r, s} := by
    simpa only [Set.singleton_union] using
      (IntermediateField.adjoin_adjoin_left (F := F) (S := {r}) {s})
  have hcT : IsSquare (algebraMap K T (algebraMap F K c)) := by
    obtain ⟨x, hx⟩ := hc
    let y : T := ⟨x.val, by
      change x.val ∈ T.restrictScalars F
      rw [hT]
      exact x.property⟩
    refine ⟨y, ?_⟩
    apply Subtype.ext
    have hh := congrArg (fun z : IntermediateField.adjoin F {r, s} => (z : L)) hx
    simpa [y] using hh
  have hbK : ¬ IsSquare (algebraMap F K b) := by
    intro h
    rcases square_criterion a b r hr ha h2 h with h | h
    · exact hb h
    · exact hab h
  have hsK : s ^ 2 = algebraMap K L (algebraMap F K b) := by
    exact hs.trans (IsScalarTower.algebraMap_apply F K L b)
  have h2K : (2 : K) ≠ 0 := by
    simpa only [map_ofNat] using (map_ne_zero (algebraMap F K)).mpr h2
  rcases square_criterion (algebraMap F K b) (algebraMap F K c) s hsK hbK h2K hcT
      with h | h
  · rcases square_criterion a c r hr ha h2 h with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  · have hbc : IsSquare (algebraMap F K (b * c)) := by simpa only [map_mul] using h
    rcases square_criterion a (b * c) r hr ha h2 hbc with h | h
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr h))

end QuadraticSquareCriterion

variable (F : Type*) [Field F]

/-- The degree of a square root of a nonsquare is exactly two, in any extension. -/
theorem finrank_adjoin_square_root {E : Type*} [Field E] [Algebra F E]
    {a : F} {x : E} (hx : x ^ 2 = algebraMap F E a)
    (ha : ∀ u : F, u ^ 2 ≠ a) :
    Module.finrank F (IntermediateField.adjoin F {x}) = 2 := by
  have hm : (X ^ 2 - C a : F[X]).Monic := monic_X_pow_sub_C a (by decide)
  have he : aeval x (X ^ 2 - C a : F[X]) = 0 := by simp [hx]
  have hi : IsIntegral F x := ⟨_, hm, he⟩
  rw [IntermediateField.adjoin.finrank hi,
    ← minpoly.eq_of_irreducible_of_monic
      (X_pow_sub_C_irreducible_iff_of_prime Nat.prime_two |>.mpr ha) he hm,
    natDegree_X_pow_sub_C]

/-- The tower degree formula for adjoining two sets, with the actual field dimensions. -/
theorem finrank_adjoin_union {E : Type*} [Field E] [Algebra F E] (S T : Set E) :
    Module.finrank F (IntermediateField.adjoin F (S ∪ T)) =
      Module.finrank F (IntermediateField.adjoin F S) *
      Module.finrank (IntermediateField.adjoin F S)
        (IntermediateField.adjoin (IntermediateField.adjoin F S) T) := by
  rw [← IntermediateField.adjoin_adjoin_left]
  exact (Module.finrank_mul_finrank F (IntermediateField.adjoin F S)
    (IntermediateField.adjoin (IntermediateField.adjoin F S) T)).symm

/-- Independence of the three squareclasses, stated without an abstract degree invariant.
Every nonempty product of the three distinct radicands must be a nonsquare.
-/
structure IndependentSquareclasses (a b c : F) : Prop where
  first : ¬ IsSquare a
  second : ¬ IsSquare b
  third : ¬ IsSquare c
  first_second : ¬ IsSquare (a * b)
  first_third : ¬ IsSquare (a * c)
  second_third : ¬ IsSquare (b * c)
  all_three : ¬ IsSquare (a * b * c)

/-- A product formulation of squareclass independence supplies the seven explicit conditions. -/
theorem independentSquareclasses_of_products (d : Fin 3 → F)
    (h : ∀ s : Finset (Fin 3), s.Nonempty → ¬ IsSquare (∏ i ∈ s, d i)) :
    IndependentSquareclasses F (d 0) (d 1) (d 2) := by
  constructor
  · simpa using h {0} (by simp)
  · simpa using h {1} (by simp)
  · simpa using h {2} (by simp)
  · simpa using h {0, 1} (by simp)
  · simpa using h {0, 2} (by simp)
  · simpa using h {1, 2} (by simp)
  · simpa only [Finset.prod_insert, Finset.prod_singleton, Finset.mem_insert,
      Finset.mem_singleton, Fin.reduceEq, or_self, not_false_eq_true, mul_assoc] using
      h {0, 1, 2} (by simp)

/-- A chosen square root in the algebraic closure. -/
def radical (a : F) : AlgebraicClosure F :=
  Classical.choose (IsAlgClosed.exists_pow_nat_eq (algebraMap F (AlgebraicClosure F) a)
    (show 0 < (2 : ℕ) by decide))

@[simp] theorem radical_sq (a : F) :
    radical F a ^ 2 = algebraMap F (AlgebraicClosure F) a :=
  Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq
    (algebraMap F (AlgebraicClosure F) a) (show 0 < (2 : ℕ) by decide))

/-- The three-radical extension as an intermediate field of the algebraic closure. -/
def field (a b c : F) : IntermediateField F (AlgebraicClosure F) :=
  IntermediateField.adjoin F {radical F a, radical F b, radical F c}

theorem radical_integral (a : F) : IsIntegral F (radical F a) := by
  refine ⟨X ^ 2 - C a, monic_X_pow_sub_C a (by decide), ?_⟩
  simp

/-- Every individual quadratic radical generates an extension of degree at most two. -/
theorem finrank_radical_le_two (a : F) :
    Module.finrank F (IntermediateField.adjoin F {radical F a}) ≤ 2 := by
  rw [IntermediateField.adjoin.finrank (radical_integral F a)]
  have h := Polynomial.natDegree_le_natDegree
    (minpoly.min F (radical F a) (monic_X_pow_sub_C a (show (2 : ℕ) ≠ 0 by decide))
      (show aeval (radical F a) (X ^ 2 - C a) = 0 by simp))
  simpa only [natDegree_X_pow_sub_C] using h

theorem field_eq_sup (a b c : F) :
    field F a b c = (IntermediateField.adjoin F {radical F a} ⊔
      IntermediateField.adjoin F {radical F b}) ⊔
      IntermediateField.adjoin F {radical F c} := by
  simp only [field, ← IntermediateField.adjoin_union]
  congr 1
  ext x
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_union]
  tauto

instance finiteDimensional_field (a b c : F) : FiniteDimensional F (field F a b c) := by
  rw [field_eq_sup]
  let := IntermediateField.adjoin.finiteDimensional (radical_integral F a)
  let := IntermediateField.adjoin.finiteDimensional (radical_integral F b)
  let := IntermediateField.adjoin.finiteDimensional (radical_integral F c)
  infer_instance

/-- An unconditional upper bound for the actual extension degree. -/
theorem finrank_field_le_eight (a b c : F) : Module.finrank F (field F a b c) ≤ 8 := by
  rw [field_eq_sup]
  calc
    _ ≤ (Module.finrank F (IntermediateField.adjoin F {radical F a}) *
        Module.finrank F (IntermediateField.adjoin F {radical F b})) *
        Module.finrank F (IntermediateField.adjoin F {radical F c}) :=
      (IntermediateField.finrank_sup_le _ _).trans
        (Nat.mul_le_mul_right _ (IntermediateField.finrank_sup_le _ _))
    _ ≤ (2 * 2) * 2 := Nat.mul_le_mul
      (Nat.mul_le_mul (finrank_radical_le_two F a) (finrank_radical_le_two F b))
      (finrank_radical_le_two F c)
    _ = 8 := by norm_num

/-- Exact degree eight from actual nonsquareness at the three successive stages.

The hypotheses are statements about squares in explicit fields, not degree assumptions.
The theorem `finrank_field_eq_eight` below derives these hypotheses from base-field
squareclass independence.
-/
theorem finrank_field_eq_eight_of_tower_nonsquares (a b c : F)
    (ha : ∀ u : F, u ^ 2 ≠ a)
    (hb : ∀ u : IntermediateField.adjoin F {radical F a},
      u ^ 2 ≠ algebraMap F (IntermediateField.adjoin F {radical F a}) b)
    (hc : ∀ u : IntermediateField.adjoin F {radical F a, radical F b},
      u ^ 2 ≠ algebraMap F (IntermediateField.adjoin F {radical F a, radical F b}) c) :
    Module.finrank F (field F a b c) = 8 := by
  have da := finrank_adjoin_square_root F (radical_sq F a) ha
  have db : Module.finrank (IntermediateField.adjoin F {radical F a})
      (IntermediateField.adjoin (IntermediateField.adjoin F {radical F a})
        {radical F b}) = 2 := by
    apply finrank_adjoin_square_root _ (a := algebraMap F _ b) _ hb
    simpa only [← IsScalarTower.algebraMap_apply] using radical_sq F b
  have dab : Module.finrank F
      (IntermediateField.adjoin F {radical F a, radical F b}) = 4 := by
    have h := finrank_adjoin_union F ({radical F a} : Set (AlgebraicClosure F))
      {radical F b}
    simp only [Set.singleton_union, da, db] at h
    exact h
  have dc : Module.finrank (IntermediateField.adjoin F {radical F a, radical F b})
      (IntermediateField.adjoin (IntermediateField.adjoin F {radical F a, radical F b})
        {radical F c}) = 2 := by
    apply finrank_adjoin_square_root _ (a := algebraMap F _ c) _ hc
    simpa only [← IsScalarTower.algebraMap_apply] using radical_sq F c
  have h := finrank_adjoin_union F ({radical F a, radical F b} : Set (AlgebraicClosure F))
    {radical F c}
  have hs : ({radical F a, radical F b} : Set (AlgebraicClosure F)) ∪ {radical F c} =
      {radical F a, radical F b, radical F c} := by
    ext x
    simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  rw [hs, dab, dc] at h
  exact h

/-- Independence of the actual squareclasses forces actual extension degree eight. -/
theorem finrank_field_eq_eight (a b c : F) (h2 : (2 : F) ≠ 0)
    (hind : IndependentSquareclasses F a b c) :
    Module.finrank F (field F a b c) = 8 := by
  apply finrank_field_eq_eight_of_tower_nonsquares F a b c
  · intro u hu
    exact hind.first ⟨u, by simpa only [sq] using hu.symm⟩
  · intro u hu
    have hs : IsSquare (algebraMap F (IntermediateField.adjoin F {radical F a}) b) :=
      ⟨u, by simpa only [sq] using hu.symm⟩
    rcases QuadraticSquareCriterion.square_criterion a b (radical F a) (radical_sq F a)
        hind.first h2 hs with h | h
    · exact hind.second h
    · exact hind.first_second h
  · intro u hu
    have hs : IsSquare (algebraMap F
        (IntermediateField.adjoin F {radical F a, radical F b}) c) :=
      ⟨u, by simpa only [sq] using hu.symm⟩
    rcases QuadraticSquareCriterion.biquadratic_square_criterion a b c
        (radical F a) (radical F b) (radical_sq F a) (radical_sq F b)
        hind.first hind.second hind.first_second h2 hs with h | h | h | h
    · exact hind.third h
    · exact hind.first_third h
    · exact hind.second_third h
    · exact hind.all_three (by simpa only [mul_assoc] using h)

/-- Direct product formulation of the degree-eight result. -/
theorem finrank_field_eq_eight_of_products (d : Fin 3 → F) (h2 : (2 : F) ≠ 0)
    (h : ∀ s : Finset (Fin 3), s.Nonempty → ¬ IsSquare (∏ i ∈ s, d i)) :
    Module.finrank F (field F (d 0) (d 1) (d 2)) = 8 :=
  finrank_field_eq_eight F _ _ _ h2 (independentSquareclasses_of_products F d h)

/-- The first chosen square root, regarded as an element of the constructed field. -/
def root₁ (a b c : F) : field F a b c :=
  ⟨radical F a, IntermediateField.subset_adjoin F _ (by simp)⟩

/-- The second chosen square root, regarded as an element of the constructed field. -/
def root₂ (a b c : F) : field F a b c :=
  ⟨radical F b, IntermediateField.subset_adjoin F _ (by simp)⟩

/-- The third chosen square root, regarded as an element of the constructed field. -/
def root₃ (a b c : F) : field F a b c :=
  ⟨radical F c, IntermediateField.subset_adjoin F _ (by simp)⟩

@[simp] theorem root₁_sq (a b c : F) :
    root₁ F a b c ^ 2 = algebraMap F (field F a b c) a := by
  apply Subtype.ext
  exact radical_sq F a

@[simp] theorem root₂_sq (a b c : F) :
    root₂ F a b c ^ 2 = algebraMap F (field F a b c) b := by
  apply Subtype.ext
  exact radical_sq F b

@[simp] theorem root₃_sq (a b c : F) :
    root₃ F a b c ^ 2 = algebraMap F (field F a b c) c := by
  apply Subtype.ext
  exact radical_sq F c

/-- These same three roots generate the whole constructed field over `F`. -/
theorem roots_generate (a b c : F) :
    IntermediateField.adjoin F {root₁ F a b c, root₂ F a b c, root₃ F a b c} = ⊤ := by
  apply IntermediateField.lift_injective (field F a b c)
  simp only [IntermediateField.lift_adjoin, IntermediateField.lift_top,
    Set.image_insert_eq, Set.image_singleton, root₁, root₂, root₃]
  rfl

end FourCorner.Multiquadratic

#print axioms FourCorner.Multiquadratic.finrank_field_le_eight
#print axioms FourCorner.Multiquadratic.roots_generate

#print axioms FourCorner.Multiquadratic.finrank_field_eq_eight_of_tower_nonsquares

#print axioms FourCorner.Multiquadratic.finrank_field_eq_eight
#print axioms FourCorner.Multiquadratic.finrank_field_eq_eight_of_products
