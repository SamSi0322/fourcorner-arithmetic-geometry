import geometry.OppositeFunctionField

noncomputable section
open scoped BigOperators
open Polynomial

namespace FourCorner.OppositeNormalizedField
open OppositePolynomials
variable {K : Type*} [Field K] [CharZero K]

/-- These are the radicands of the original three equations, before clearing A. -/
def value (mu nu : K) (i : Fin 3) : RatFunc K :=
  OppositeFunctionField.radicandValue mu nu i / algebraMap K (RatFunc K) (A mu nu)

/-- The function field generated by the literal ordered roots P,Q,R. -/
abbrev field (mu nu : K) : IntermediateField (RatFunc K) (AlgebraicClosure (RatFunc K)) :=
  Multiquadratic.field (RatFunc K) (value mu nu 0) (value mu nu 1) (value mu nu 2)

theorem nonempty_product_nonsquare [IsAlgClosed K] {mu nu : K}
    (hmu : mu ≠ 0) (hnu : nu ≠ 0) (hA : A mu nu ≠ 0)
    (hB : B mu nu ≠ 0) (hS : S mu nu ≠ 0)
    (s : Finset (Fin 3)) (hne : s.Nonempty) :
    ¬ IsSquare (∏ i ∈ s, value mu nu i) := by
  obtain ⟨a, ha⟩ := IsAlgClosed.exists_pow_nat_eq (A mu nu) (by decide : 0 < (2 : ℕ))
  have hsq : IsSquare (algebraMap K (RatFunc K) (A mu nu)) := by
    apply IsSquare.map
    exact ⟨a, by simpa only [pow_two] using ha.symm⟩
  have hA' : algebraMap K (RatFunc K) (A mu nu) ≠ 0 := (_root_.map_ne_zero (algebraMap K (RatFunc K))).2 hA
  intro h
  have hh := h.mul (hsq.pow s.card)
  have heq : (∏ i ∈ s, value mu nu i) *
      (algebraMap K (RatFunc K) (A mu nu)) ^ s.card =
      ∏ i ∈ s, OppositeFunctionField.radicandValue mu nu i := by
    simp only [value, Finset.prod_div_distrib, Finset.prod_const]
    exact div_mul_cancel₀ _ (pow_ne_zero _ hA')
  rw [heq] at hh
  exact OppositeFunctionField.nonempty_product_nonsquare hmu hnu hA hB hS s hne hh

theorem finrank_field_eq_eight [IsAlgClosed K] {mu nu : K}
    (hmu : mu ≠ 0) (hnu : nu ≠ 0) (hA : A mu nu ≠ 0)
    (hB : B mu nu ≠ 0) (hS : S mu nu ≠ 0) :
    Module.finrank (RatFunc K) (field mu nu) = 8 :=
  Multiquadratic.finrank_field_eq_eight_of_products (RatFunc K) (value mu nu)
    (by norm_num) (nonempty_product_nonsquare hmu hnu hA hB hS)

theorem rational_finrank_field_eq_eight [IsAlgClosed K] (mu nu : ℚ)
    (hnu : nu ≠ 0) (hpos : 0 < mu / nu) (hlt : mu / nu < 2) :
    Module.finrank (RatFunc K) (field (algebraMap ℚ K mu) (algebraMap ℚ K nu)) = 8 := by
  have hmu : mu ≠ 0 := by intro hz; simp [hz] at hpos
  apply finrank_field_eq_eight
  · exact (map_ne_zero (algebraMap ℚ K)).2 hmu
  · exact (map_ne_zero (algebraMap ℚ K)).2 hnu
  · simpa only [A_map] using (map_ne_zero (algebraMap ℚ K)).2 (rational_A_ne_zero mu nu hnu)
  · simpa only [B_map] using (map_ne_zero (algebraMap ℚ K)).2
      (rational_B_ne_zero mu nu hnu hpos hlt)
  · simpa only [S_map] using (map_ne_zero (algebraMap ℚ K)).2 (rational_S_ne_zero mu nu hnu)

/- Clearing A recovers the first original affine equation identically. -/
omit [CharZero K] in
theorem value_zero_equation (mu nu : K) (hA : A mu nu ≠ 0) :
    algebraMap K (RatFunc K) (A mu nu) *
      (value mu nu 0 - 2 * (algebraMap K (RatFunc K) nu)^2) = RatFunc.X ^ 2 := by
  have hA' : algebraMap K (RatFunc K) (A mu nu) ≠ 0 := (_root_.map_ne_zero (algebraMap K (RatFunc K))).2 hA
  simp only [value, OppositeFunctionField.radicandValue, radicand, fZero,
    map_add, map_pow, RatFunc.algebraMap_X, RatFunc.algebraMap_C]
  change algebraMap K (RatFunc K) (A mu nu) *
    ((RatFunc.X^2 + algebraMap K (RatFunc K) (2 * A mu nu * nu^2)) /
      algebraMap K (RatFunc K) (A mu nu) - 2 * (algebraMap K (RatFunc K) nu)^2) = _
  simp only [map_mul, map_pow, map_ofNat]
  field_simp
  try simp only [← RatFunc.algebraMap_eq_C]
  ring

omit [CharZero K] in
theorem value_plus_equation (mu nu : K) (hA : A mu nu ≠ 0) :
    value mu nu 1 = value mu nu 0 + (algebraMap K (RatFunc K) mu)^2 + 2 * RatFunc.X := by
  have hA' : algebraMap K (RatFunc K) (A mu nu) ≠ 0 :=
    (_root_.map_ne_zero (algebraMap K (RatFunc K))).2 hA
  simp only [value, OppositeFunctionField.radicandValue, radicand, fPlus, fZero,
    map_add, map_pow, RatFunc.algebraMap_X, RatFunc.algebraMap_C]
  change ((RatFunc.X + algebraMap K (RatFunc K) (A mu nu))^2 +
      algebraMap K (RatFunc K) (2 * A mu nu * mu^2)) /
      algebraMap K (RatFunc K) (A mu nu) = _
  simp only [A, map_mul, map_sub, map_pow, map_ofNat] at hA' ⊢
  field_simp
  try simp only [← RatFunc.algebraMap_eq_C]
  ring

omit [CharZero K] in
theorem value_minus_equation (mu nu : K) (hA : A mu nu ≠ 0) :
    value mu nu 2 = value mu nu 0 + (algebraMap K (RatFunc K) mu)^2 - 2 * RatFunc.X := by
  have hA' : algebraMap K (RatFunc K) (A mu nu) ≠ 0 :=
    (_root_.map_ne_zero (algebraMap K (RatFunc K))).2 hA
  simp only [value, OppositeFunctionField.radicandValue, radicand, fMinus, fZero,
    map_add, map_sub, map_pow, RatFunc.algebraMap_X, RatFunc.algebraMap_C]
  change ((RatFunc.X - algebraMap K (RatFunc K) (A mu nu))^2 +
      algebraMap K (RatFunc K) (2 * A mu nu * mu^2)) /
      algebraMap K (RatFunc K) (A mu nu) = _
  simp only [A, map_mul, map_sub, map_pow, map_ofNat] at hA' ⊢
  field_simp
  try simp only [← RatFunc.algebraMap_eq_C]
  ring

#print axioms nonempty_product_nonsquare
#print axioms finrank_field_eq_eight
#print axioms rational_finrank_field_eq_eight
#print axioms value_zero_equation
end FourCorner.OppositeNormalizedField
